@model CIVS.Models.Medicamento

@{
    ViewData["Title"] = "Crear medicamento o insumo";
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<form asp-action="CrearMedicamentoInsumo" asp-controller="Medicamento" method="post" class="mt-3">
    <div class="bg-white border rounded-4 shadow-sm p-4">

        <!-- Encabezado -->
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill"
                          style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                        Farmacia
                    </span>
                    <span class="text-muted small">Medicamentos e Insumos</span>
                </div>
                <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                    Registrar medicamento o insumo
                </h2>
            </div>
        </div>

        <hr class="my-3" />

        <!-- Datos del medicamento -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 fw-semibold mb-0">Datos del medicamento o insumo</h3>
                <span class="text-muted small">Campos obligatorios</span>
            </div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="MedicamentoNombre" class="form-label">Nombre</label>
                    <input asp-for="MedicamentoNombre" class="form-control"
                           placeholder="Ej. Amoxicilina, Gasa estéril, Suero fisiológico" />
                    <span asp-validation-for="MedicamentoNombre" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MedicamentoPresentacion" class="form-label">
                        Presentación
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <input asp-for="MedicamentoPresentacion" class="form-control"
                           placeholder="Ej. Tabletas, Jarabe, Crema" />
                    <span asp-validation-for="MedicamentoPresentacion" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MedicamentoConcentracion" class="form-label">
                        Concentración
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <input asp-for="MedicamentoConcentracion" class="form-control"
                           placeholder="Ej. 500 mg, 5 mg/5 ml" />
                    <span asp-validation-for="MedicamentoConcentracion" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MedicamentoUnidad" class="form-label">
                        Unidad
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <input asp-for="MedicamentoUnidad" class="form-control"
                           placeholder="Ej. Caja x 10, Frasco 120ml" />
                    <span asp-validation-for="MedicamentoUnidad" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MedicamentoPrecio" class="form-label">
                        Precio unitario
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">Q</span>
                        <input asp-for="MedicamentoPrecio" type="number" step="0.01" min="0"
                               class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="MedicamentoPrecio" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <!-- Botones -->
        <div class="d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">Guardar medicamento</button>
            <a asp-controller="Medicamento" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        setTimeout(function () {
            const alertEl = document.querySelector('.alert.alert-success');
            if (alertEl) bootstrap.Alert.getOrCreateInstance(alertEl).close();
        }, 3000);
    </script>
}