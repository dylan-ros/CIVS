@{
    ViewData["Title"] = "Inicio";
}

<!-- Bienvenida (sin borde, estilo clínica) -->
<div class="mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="text-start">
            <h1 class="display-5 fw-semibold mb-2" style="color:#1e7e34;">
                Bienvenido a CIVS
            </h1>
            <p class="fs-5 mb-0 text-muted">Clínica Integral Vida Sana, S.A.</p>
        </div>

        <div class="text-muted small">
            @DateTime.Today.ToString("dddd, dd 'de' MMMM 'de' yyyy")
        </div>
    </div>
</div>
