<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CIVS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CIVS.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid">
                <!-- Logo / Brand -->
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="rounded-3 px-2 py-1 border" style="letter-spacing:1px;">CIVS</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <!-- Left nav -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">                 
                        <!-- FRONT OFFICE Module -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold" href="#" id="frontOfficeDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Front Office
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="frontOfficeDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Index">
                                        Consulta de pacientes
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Medico" asp-action="Index">
                                        Consulta de médicos
                                    </a>
                                </li>                           
                                <li>
                                    <a class="dropdown-item" asp-controller="Cita" asp-action="Index">
                                        Consulta de citas
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Paciente" asp-action="CrearPaciente">
                                        Crear nuevo paciente
                                    </a>                                   
                                    <a class="dropdown-item" asp-controller="Cita" asp-action="CrearCitas">
                                        Crear nueva cita
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Right nav -->
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-primary"
                           asp-controller="Cita" asp-action="Index">
                            Ver Citas
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-4">
        <div class="container d-flex justify-content-between align-items-center">
            <span> &copy; 2026 - CIVS (Clínica Integral Vida Sana, S.A.) </span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>