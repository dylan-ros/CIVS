@using System.Security.Claims
@using System.Globalization

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var isAdmin = User.IsInRole("Administrador") || User.IsInRole("Admin");
    var isMedico = User.IsInRole("Medico") || User.IsInRole("Médico");
    var isContabilidad = User.IsInRole("Contabilidad");
    var isCajero = User.IsInRole("Cajero");
    var isLaboratorista = User.IsInRole("Laboratorista") || User.IsInRole("Laboratorio");
    var isRecepcionista = User.IsInRole("Recepcionista") || User.IsInRole("Recepcion") || User.IsInRole("Recepción");
    var isFarmacia = User.IsInRole("Farmacia") || User.IsInRole("Farmaceutico") || User.IsInRole("Farmacéutico");

    var puedeFrontOffice = isAdmin || isMedico || isRecepcionista;
    var puedeFarmacia = isAdmin || isFarmacia;
    var puedeLaboratorio = isAdmin || isMedico || isLaboratorista;
    var puedeCaja = isAdmin || isContabilidad || isCajero;
    var puedeAdmin = isAdmin;

    var nombreUsuario = User.FindFirst("NombreCompleto")?.Value
        ?? User.Identity?.Name
        ?? "Usuario";

    var rolPrincipal = isAdmin ? "Administrador"
        : isContabilidad ? "Contabilidad"
        : isCajero ? "Caja"
        : isMedico ? "Médico"
        : isLaboratorista ? "Laboratorio"
        : isFarmacia ? "Farmacia"
        : isRecepcionista ? "Recepción"
        : "Usuario";

    var inicioController = (isContabilidad || isCajero) && !isAdmin ? "CorteCaja" : "Home";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CIVS</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CIVS.styles.css" asp-append-version="true" />
</head>

<body class="@(isAuthenticated ? "layout-auth" : "layout-public")">

    <!-- NAVBAR SUPERIOR -->
    <header>
        <nav class="navbar navbar-light bg-white border-bottom shadow-sm px-4 py-2">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
               asp-controller="@inicioController"
               asp-action="Index">
                <span class="brand-logo-box">
                    <img src="~/logo-civs.png" alt="CIVS" class="brand-logo" />
                </span>
            </a>

            <div class="d-flex align-items-center gap-3">
                @if (isAuthenticated)
                {
                    <div class="d-none d-lg-flex flex-column align-items-end lh-sm">
                        <span class="small fw-semibold" style="color:#1a5c38;">
                            @nombreUsuario
                        </span>
                        <span class="badge rounded-pill mt-1"
                              style="background:#e9f7ef;color:#1e7e34;border:1px solid #cfeedd;font-size:.68rem;">
                            @rolPrincipal
                        </span>
                    </div>

                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                            Cerrar sesión
                        </button>
                    </form>
                }
            </div>
        </nav>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="app-shell">
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>

    @if (isAuthenticated)
    {
        <!-- DOCK INFERIOR -->
        <div id="dock-wrapper">
            <div id="dock">

                <!-- INICIO -->
                <div class="dock-item" data-modulo="home">
                    <div class="dock-menu" id="menu-home">
                        @if ((isContabilidad || isCajero) && !isAdmin)
                        {
                            <a asp-controller="CorteCaja" asp-action="Index">Dashboard financiero</a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Index">Inicio</a>
                        }
                    </div>

                    <button type="button" class="dock-icon" onclick="toggleMenu('home', event)" title="Inicio">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
                            <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625c-1.036 0-1.875-.84-1.875-1.875v-6.198c.03-.028.061-.056.091-.086L12 5.43z" />
                        </svg>
                        <span>Inicio</span>
                    </button>
                </div>

                <!-- FRONT OFFICE -->
                @if (puedeFrontOffice)
                {
                    <div class="dock-item" data-modulo="frontoffice">
                        <div class="dock-menu" id="menu-frontoffice">
                            <a asp-controller="Paciente" asp-action="Index">Consulta pacientes</a>

                            @if (isAdmin || isRecepcionista)
                            {
                                <a asp-controller="Medico" asp-action="Index">Consulta médicos</a>
                                <a asp-controller="Cita" asp-action="Index">Consulta citas</a>
                                <div class="dock-menu-divider"></div>
                                <a asp-controller="Paciente" asp-action="CrearPaciente">+ Nuevo paciente</a>
                                <a asp-controller="Cita" asp-action="CrearCitas">+ Nueva cita</a>
                            }

                            @if (isMedico && !isAdmin)
                            {
                                <a asp-controller="Cita" asp-action="Index">Mi agenda</a>
                            }
                        </div>

                        <button type="button" class="dock-icon" onclick="toggleMenu('frontoffice', event)" title="Front Office">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M4.5 6.375a4.125 4.125 0 118.25 0 4.125 4.125 0 01-8.25 0zM14.25 8.625a3.375 3.375 0 116.75 0 3.375 3.375 0 01-6.75 0zM1.5 19.125a7.125 7.125 0 0114.25 0v.003l-.001.119a.75.75 0 01-.363.63 13.067 13.067 0 01-6.761 1.873c-2.472 0-4.786-.684-6.76-1.873a.75.75 0 01-.364-.63l-.001-.122zM17.25 19.128l-.001.144a2.25 2.25 0 01-.233.96 10.088 10.088 0 005.06-1.01.75.75 0 00.42-.643 4.875 4.875 0 00-6.957-4.611 8.586 8.586 0 011.71 5.157v.003z" />
                            </svg>
                            <span>Front</span>
                        </button>
                    </div>
                }

                <!-- FARMACIA -->
                @if (puedeFarmacia)
                {
                    <div class="dock-item" data-modulo="farmacia">
                        <div class="dock-menu" id="menu-farmacia">
                            <a asp-controller="Medicamento" asp-action="Index">Consulta medicamentos</a>
                            <div class="dock-menu-divider"></div>
                            <a asp-controller="Medicamento" asp-action="CrearMedicamentoInsumo">+ Nuevo medicamento</a>
                        </div>

                        <button type="button" class="dock-icon" onclick="toggleMenu('farmacia', event)" title="Farmacia">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                <path fill-rule="evenodd" d="M11.828 2.25c-.916 0-1.699.663-1.85 1.567l-.091.549a.798.798 0 01-.517.608 7.45 7.45 0 00-.478.198.798.798 0 01-.796-.064l-.453-.324a1.875 1.875 0 00-2.416.2l-.243.243a1.875 1.875 0 00-.2 2.416l.324.453a.798.798 0 01.064.796 7.448 7.448 0 00-.198.478.798.798 0 01-.608.517l-.55.092a1.875 1.875 0 00-1.566 1.849v.344c0 .916.663 1.699 1.567 1.85l.549.091c.281.047.508.25.608.517.06.162.127.321.198.478a.798.798 0 01-.064.796l-.324.453a1.875 1.875 0 00.2 2.416l.243.243c.648.648 1.67.733 2.416.2l.453-.324a.798.798 0 01.796-.064c.157.071.316.137.478.198.267.1.47.327.517.608l.092.55c.15.903.932 1.566 1.849 1.566h.344c.916 0 1.699-.663 1.85-1.567l.091-.549a.798.798 0 01.517-.608 7.52 7.52 0 00.478-.198.798.798 0 01.796.064l.453.324a1.875 1.875 0 002.416-.2l.243-.243c.648-.648.733-1.67.2-2.416l-.324-.453a.798.798 0 01-.064-.796c.071-.157.137-.316.198-.478.1-.267.327-.47.608-.517l.55-.091a1.875 1.875 0 001.566-1.85v-.344c0-.916-.663-1.699-1.567-1.85l-.549-.091a.798.798 0 01-.608-.517 7.507 7.507 0 00-.198-.478.798.798 0 01.064-.796l.324-.453a1.875 1.875 0 00-.2-2.416l-.243-.243a1.875 1.875 0 00-2.416-.2l-.453.324a.798.798 0 01-.796.064 7.462 7.462 0 00-.478-.198.798.798 0 01-.608-.517l-.091-.55a1.875 1.875 0 00-1.85-1.566h-.344zM12 15.75a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z" clip-rule="evenodd" />
                            </svg>
                            <span>Farmacia</span>
                        </button>
                    </div>
                }

                <!-- LABORATORIO -->
                @if (puedeLaboratorio)
                {
                    <div class="dock-item" data-modulo="laboratorio">
                        <div class="dock-menu" id="menu-laboratorio">
                            <a asp-controller="Laboratorio" asp-action="Index">Consulta órdenes</a>

                            @if (isAdmin || isLaboratorista)
                            {
                                <div class="dock-menu-divider"></div>
                                <a asp-controller="Laboratorio" asp-action="CrearOrden">+ Nueva orden</a>
                                <a asp-controller="Laboratorio" asp-action="CrearExamen">+ Nuevo examen</a>
                                <a asp-controller="Laboratorio" asp-action="CrearReceta">+ Nueva receta</a>
                            }
                        </div>

                        <button type="button" class="dock-icon" onclick="toggleMenu('laboratorio', event)" title="Laboratorio">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                <path fill-rule="evenodd" d="M10.5 3.798v5.02a3 3 0 01-.879 2.121l-2.377 2.377a9.845 9.845 0 015.091 1.013 8.315 8.315 0 005.713.636l.285-.071-3.954-3.955a3 3 0 01-.879-2.121v-5.02a23.614 23.614 0 01-3 0zm4.5.138a.75.75 0 00.093-1.495A24.837 24.837 0 0012 2.25a25.048 25.048 0 00-3.093.191A.75.75 0 009 3.936v4.882a1.5 1.5 0 01-.44 1.06l-6.293 6.291c-1.62 1.621-.903 4.475 1.471 4.88 2.686.46 5.447.698 8.262.698 2.816 0 5.576-.239 8.262-.697 2.373-.406 3.092-3.26 1.47-4.881L15.44 9.879A1.5 1.5 0 0115 8.818V4.936z" clip-rule="evenodd" />
                            </svg>
                            <span>Lab</span>
                        </button>
                    </div>
                }

                <!-- CORTE DE CAJA -->
                @if (puedeCaja)
                {
                    <div class="dock-item" data-modulo="caja">
                        <div class="dock-menu" id="menu-caja">
                            <a asp-controller="CorteCaja" asp-action="Index">Reporte financiero</a>
                            <div class="dock-menu-divider"></div>
                            <a asp-controller="CorteCaja" asp-action="CrearFactura">+ Nueva factura</a>
                        </div>

                        <button type="button" class="dock-icon" onclick="toggleMenu('caja', event)" title="Corte de Caja">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M2.273 5.625A4.483 4.483 0 015.25 4.5h13.5c1.141 0 2.183.425 2.977 1.125A3 3 0 0018.75 3H5.25a3 3 0 00-2.977 2.625zM2.273 8.625A4.483 4.483 0 015.25 7.5h13.5c1.141 0 2.183.425 2.977 1.125A3 3 0 0018.75 6H5.25a3 3 0 00-2.977 2.625zM5.25 9a3 3 0 00-3 3v6a3 3 0 003 3h13.5a3 3 0 003-3v-6a3 3 0 00-3-3H5.25zm.75 6.75a.75.75 0 000 1.5h7.5a.75.75 0 000-1.5H6zm0-3a.75.75 0 000 1.5h3a.75.75 0 000-1.5H6z" />
                            </svg>
                            <span>Caja</span>
                        </button>
                    </div>
                }

                <!-- ADMINISTRACIÓN -->
                @if (puedeAdmin)
                {
                    <div class="dock-item" data-modulo="admin">
                        <div class="dock-menu" id="menu-admin">
                            <a asp-controller="Admin" asp-action="Index">Panel admin</a>
                            <a asp-controller="Admin" asp-action="Usuarios">Usuarios</a>
                            <div class="dock-menu-divider"></div>
                            <a asp-controller="Admin" asp-action="CrearUsuario">+ Nuevo usuario</a>
                            <a asp-controller="Admin" asp-action="Auditoria">Bitácora</a>
                        </div>

                        <button type="button" class="dock-icon" onclick="toggleMenu('admin', event)" title="Administración">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd" />
                            </svg>
                            <span>Admin</span>
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- PANEL FLOTANTE MÓVIL -->
        <div id="dock-mobile-panel" class="dock-mobile-panel"></div>
    }

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- ESTILOS DEL LAYOUT Y DOCK -->
    <style>
        html,
        body {
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;
            background: #eef4fb;
        }

        body.layout-auth {
            padding-bottom: 120px;
        }

        body.layout-public {
            padding-bottom: 0;
        }

        .app-shell {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            padding: 24px 18px 0;
        }

        .app-main {
            width: 100%;
            padding-bottom: 24px;
        }

        .navbar {
            min-height: 64px;
        }

        .brand-logo-box {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            padding: 4px 6px;
            background: #fff;
        }

        .brand-logo {
            width: 54px;
            height: auto;
            display: block;
            object-fit: contain;
        }

        #dock-wrapper {
            position: fixed;
            left: 50%;
            bottom: 16px;
            transform: translateX(-50%);
            z-index: 9999;
            width: auto;
            max-width: calc(100vw - 24px);
            display: flex;
            justify-content: center;
            overflow: visible;
            pointer-events: none;
        }

        #dock {
            pointer-events: auto;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: rgba(255, 255, 255, .92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 228, 218, .9);
            border-radius: 28px;
            padding: 10px 14px;
            box-shadow:
                0 10px 32px rgba(0,0,0,.14),
                0 2px 8px rgba(0,0,0,.06),
                inset 0 1px 0 rgba(255,255,255,.9);
            overflow: visible;
        }

        .dock-item {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 0 0 auto;
        }

        .dock-icon {
            width: 72px;
            min-height: 58px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            cursor: pointer;
            transition: background .18s ease, transform .18s ease;
            padding: 7px 8px;
            border-radius: 18px;
            user-select: none;
            border: 0;
            background: transparent;
            font-family: inherit;
        }

        .dock-icon svg {
            width: 34px;
            height: 34px;
            color: #1a5c38;
            background: linear-gradient(145deg, #e8f5ee, #d1fae5);
            border-radius: 12px;
            padding: 7px;
            box-shadow: 0 2px 8px rgba(26,92,56,.18);
            transition: all .2s ease;
        }

        .dock-icon span {
            font-size: .64rem;
            font-weight: 600;
            color: #1a5c38;
            letter-spacing: .2px;
            white-space: nowrap;
        }

        .dock-icon:hover {
            transform: translateY(-3px);
            background: rgba(232,245,238,.75);
        }

        .dock-icon:hover svg,
        .dock-item.activo .dock-icon svg {
            background: linear-gradient(145deg, #1a5c38, #2d8653);
            color: #fff;
            box-shadow: 0 4px 14px rgba(26,92,56,.32);
        }

        .dock-item.activo .dock-icon {
            background: rgba(232,245,238,.85);
        }

        .dock-menu {
            position: absolute;
            bottom: calc(100% + 14px);
            left: 50%;
            transform: translateX(-50%) translateY(8px) scale(.96);
            background: rgba(255,255,255,.98);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212,228,218,.9);
            border-radius: 18px;
            box-shadow: 0 18px 45px rgba(15,23,42,.18), 0 4px 14px rgba(15,23,42,.10);
            padding: 8px;
            min-width: 230px;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
            z-index: 10000;
        }

        .dock-menu::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 50%;
            width: 12px;
            height: 12px;
            background: rgba(255,255,255,.98);
            border-right: 1px solid rgba(212,228,218,.9);
            border-bottom: 1px solid rgba(212,228,218,.9);
            transform: translateX(-50%) rotate(45deg);
        }

        .dock-item.activo .dock-menu {
            opacity: 1;
            visibility: visible;
            pointer-events: all;
            transform: translateX(-50%) translateY(0) scale(1);
        }

        .dock-item:first-child .dock-menu {
            left: 0;
            transform: translateX(0) translateY(8px) scale(.96);
        }

        .dock-item:first-child.activo .dock-menu {
            transform: translateX(0) translateY(0) scale(1);
        }

        .dock-item:last-child .dock-menu {
            left: auto;
            right: 0;
            transform: translateX(0) translateY(8px) scale(.96);
        }

        .dock-item:last-child.activo .dock-menu {
            transform: translateX(0) translateY(0) scale(1);
        }

        .dock-item:first-child .dock-menu::after {
            left: 38px;
        }

        .dock-item:last-child .dock-menu::after {
            left: auto;
            right: 38px;
            transform: rotate(45deg);
        }

        .dock-menu a,
        .dock-mobile-panel a {
            display: flex;
            align-items: center;
            min-height: 38px;
            padding: 9px 14px;
            border-radius: 12px;
            font-size: .86rem;
            font-weight: 500;
            color: #1a2e22;
            text-decoration: none;
            transition: background .12s, color .12s, transform .12s;
            white-space: nowrap;
        }

        .dock-menu a:hover,
        .dock-mobile-panel a:hover {
            background: #e8f5ee;
            color: #1a5c38;
            transform: translateX(2px);
        }

        .dock-menu-divider {
            height: 1px;
            background: #e8f0ec;
            margin: 4px 6px;
        }

        .dock-mobile-panel {
            display: none;
        }

        @@media (max-width: 768px) {
            body.layout-auth {
                padding-bottom: calc(112px + env(safe-area-inset-bottom));
            }

            .navbar {
                min-height: 58px;
                padding-left: 14px !important;
                padding-right: 14px !important;
            }

            .navbar .btn-outline-danger {
                padding: 5px 10px !important;
                font-size: .78rem;
            }

            .brand-logo {
                width: 46px;
            }

            .app-shell {
                max-width: 100%;
                padding: 14px 10px 0;
            }

            .app-main {
                padding-bottom: 18px;
            }

            #dock-wrapper {
                left: 0;
                right: 0;
                bottom: calc(10px + env(safe-area-inset-bottom));
                transform: none;
                width: 100%;
                max-width: 100%;
                padding: 0 8px;
                justify-content: center;
                overflow: visible;
            }

            #dock {
                width: 100%;
                max-width: 430px;
                justify-content: flex-start;
                gap: 6px;
                padding: 8px;
                border-radius: 24px;
                overflow-x: auto;
                overflow-y: hidden;
                scrollbar-width: none;
                -webkit-overflow-scrolling: touch;
            }

            #dock::-webkit-scrollbar {
                display: none;
            }

            .dock-icon {
                width: 58px;
                min-height: 56px;
                padding: 6px 4px;
                border-radius: 16px;
            }

            .dock-icon svg {
                width: 32px;
                height: 32px;
                padding: 7px;
            }

            .dock-icon span {
                font-size: .56rem;
                max-width: 58px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .dock-icon:hover,
            .dock-item.activo .dock-icon {
                transform: none;
            }

            /* En móvil se ocultan los menús originales para evitar que el dock los corte */
            .dock-menu {
                display: none !important;
            }

            /* Este panel móvil sí flota fuera del dock */
            .dock-mobile-panel {
                position: fixed;
                left: 12px;
                right: 12px;
                bottom: calc(92px + env(safe-area-inset-bottom));
                z-index: 20000;
                display: block;
                background: rgba(255,255,255,.98);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border: 1px solid rgba(212,228,218,.95);
                border-radius: 22px;
                box-shadow: 0 18px 45px rgba(15,23,42,.20), 0 4px 14px rgba(15,23,42,.10);
                padding: 10px;
                max-height: 55vh;
                overflow-y: auto;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transform: translateY(12px) scale(.98);
                transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
            }

            .dock-mobile-panel.show {
                opacity: 1;
                visibility: visible;
                pointer-events: all;
                transform: translateY(0) scale(1);
            }

            .dock-mobile-panel a {
                min-height: 44px;
                font-size: .9rem;
                border-radius: 14px;
                white-space: normal;
            }

            .dock-mobile-panel .dock-menu-divider {
                height: 1px;
                background: #e8f0ec;
                margin: 6px;
            }
        }

        @@media (max-width: 390px) {
            .app-shell {
                padding-left: 8px;
                padding-right: 8px;
            }

            #dock {
                max-width: 100%;
            }

            .dock-icon {
                width: 55px;
            }

            .dock-icon span {
                font-size: .55rem;
                max-width: 54px;
            }
        }
    </style>

    <script>
        const dockMobileQuery = window.matchMedia('(max-width: 768px)');

        function closeDockMenus() {
            document.querySelectorAll('.dock-item')
                .forEach(i => i.classList.remove('activo'));

            const mobilePanel = document.getElementById('dock-mobile-panel');

            if (mobilePanel) {
                mobilePanel.classList.remove('show');
                mobilePanel.removeAttribute('data-modulo');
            }
        }

        function toggleMenu(modulo, event) {
            if (event) {
                event.stopPropagation();
            }

            const item = document.querySelector(`[data-modulo="${modulo}"]`);

            if (!item) return;

            const estaActivo = item.classList.contains('activo');

            /*
                En teléfono se usa un panel flotante independiente.
                Esto evita que el dock con scroll horizontal recorte las opciones.
            */
            if (dockMobileQuery.matches) {
                const sourceMenu = item.querySelector('.dock-menu');
                const mobilePanel = document.getElementById('dock-mobile-panel');

                if (!sourceMenu || !mobilePanel) return;

                const mismoMenuAbierto =
                    mobilePanel.classList.contains('show') &&
                    mobilePanel.getAttribute('data-modulo') === modulo;

                closeDockMenus();

                if (!mismoMenuAbierto) {
                    item.classList.add('activo');
                    mobilePanel.innerHTML = sourceMenu.innerHTML;
                    mobilePanel.setAttribute('data-modulo', modulo);
                    mobilePanel.classList.add('show');

                    mobilePanel.querySelectorAll('a').forEach(function (link) {
                        link.addEventListener('click', function () {
                            closeDockMenus();
                        });
                    });
                }

                return;
            }

            /*
                En escritorio se usa el menú original sobre cada ícono.
            */
            closeDockMenus();

            if (!estaActivo) {
                item.classList.add('activo');
            }
        }

        document.addEventListener('click', function (e) {
            if (!e.target.closest('#dock-wrapper') && !e.target.closest('#dock-mobile-panel')) {
                closeDockMenus();
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeDockMenus();
            }
        });

        window.addEventListener('resize', function () {
            closeDockMenus();
        });
    </script>

</body>
</html>