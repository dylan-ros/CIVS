@model CIVS.Models.Medico

@{
    ViewData["Title"] = "Crear médico";
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<form asp-action="CrearMedico" asp-controller="Medico" method="post" class="mt-3">
    <div class="bg-white border rounded-4 shadow-sm p-4">

        <!-- Encabezado -->
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill"
                          style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                        Front Office
                    </span>
                    <span class="text-muted small">Médicos</span>
                </div>
                <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                    Registrar nuevo médico
                </h2>
            </div>
        </div>

        <hr class="my-3" />

        <!-- Datos profesionales -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 fw-semibold mb-0">Datos profesionales</h3>
                <span class="text-muted small">Campos obligatorios</span>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MedicoColegiado" class="form-label">No. de colegiado</label>
                    <input asp-for="MedicoColegiado" class="form-control" placeholder="Ej. 12345" />
                    <span asp-validation-for="MedicoColegiado" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EspecialidadId" class="form-label">Especialidad</label>
                    <select asp-for="EspecialidadId" asp-items="ViewBag.Especialidades" class="form-select">
                        <option value="">-- Seleccionar especialidad --</option>
                    </select>
                    <span asp-validation-for="EspecialidadId" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Datos personales -->
        <div class="mb-4">
            <h3 class="h6 fw-semibold mb-2">Datos personales</h3>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MedicoNombres" class="form-label">Nombres</label>
                    <input asp-for="MedicoNombres" class="form-control" placeholder="Ej. Carlos Antonio" />
                    <span asp-validation-for="MedicoNombres" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MedicoApellidos" class="form-label">Apellidos</label>
                    <input asp-for="MedicoApellidos" class="form-control" placeholder="Ej. García López" />
                    <span asp-validation-for="MedicoApellidos" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Contacto -->
        <div class="mb-2">
            <h3 class="h6 fw-semibold mb-2">Contacto</h3>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MedicoTelefono" class="form-label">Teléfono</label>
                    <input asp-for="MedicoTelefono" class="form-control" placeholder="+502 ____ ____" />
                    <span asp-validation-for="MedicoTelefono" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MedicoEmail" class="form-label">
                        Correo electrónico
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <input asp-for="MedicoEmail" class="form-control" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="MedicoEmail" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <!-- Botones -->


        <div class="d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">Guardar médico</button>
            <a asp-controller="Medico" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        setTimeout(function () {
            const alertEl = document.querySelector('.alert.alert-success');
            if (alertEl) bootstrap.Alert.getOrCreateInstance(alertEl).close();
        }, 3000);
    </script>
}