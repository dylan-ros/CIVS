@model CIVS.Models.Paciente

@{
    ViewData["Title"] = "Editar paciente";
}

<div class="bg-white border rounded-4 shadow-sm p-4 mt-3">

    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill"
                      style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                    Front Office
                </span>
                <span class="text-muted small">Pacientes</span>
            </div>

            <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34;">
                Editar paciente
            </h2>

            <p class="text-muted mb-0">
                Modificá la información general del paciente.
            </p>
        </div>
    </div>

    <hr class="my-3" />

    <form asp-action="EditarPaciente" method="post" class="row g-3">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="PacienteId" />

        <div class="col-md-4">
            <label asp-for="PacienteDPI" class="form-label">DPI</label>
            <input asp-for="PacienteDPI" class="form-control" />
            <span asp-validation-for="PacienteDPI" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="PacienteNombres" class="form-label">Nombres</label>
            <input asp-for="PacienteNombres" class="form-control" />
            <span asp-validation-for="PacienteNombres" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="PacienteApellido" class="form-label">Apellidos</label>
            <input asp-for="PacienteApellido" class="form-control" />
            <span asp-validation-for="PacienteApellido" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="PacienteTelefono" class="form-label">Teléfono</label>
            <input asp-for="PacienteTelefono" class="form-control" />
            <span asp-validation-for="PacienteTelefono" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="PacienteCorreo" class="form-label">Correo</label>
            <input asp-for="PacienteCorreo" class="form-control" />
            <span asp-validation-for="PacienteCorreo" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="PacienteNacimiento" class="form-label">Fecha de nacimiento</label>
            <input asp-for="PacienteNacimiento" type="date" class="form-control" />
            <span asp-validation-for="PacienteNacimiento" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label asp-for="PacienteDireccion" class="form-label">Dirección</label>
            <textarea asp-for="PacienteDireccion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="PacienteDireccion" class="text-danger small"></span>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}