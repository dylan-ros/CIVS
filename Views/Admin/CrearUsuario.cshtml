@{
    ViewData["Title"] = "Crear usuario";
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-3">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form asp-action="CrearUsuario" asp-controller="Admin" method="post" class="mt-3">
    <div class="bg-white border rounded-4 shadow-sm p-4">

        <!-- Encabezado -->
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill"
                          style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                        Administración
                    </span>
                    <span class="text-muted small">Usuarios</span>
                </div>
                <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                    Crear nuevo usuario
                </h2>
            </div>
        </div>

        <hr class="my-3" />

        <!-- Datos personales -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 fw-semibold mb-0">Datos personales</h3>
                <span class="text-muted small">Requeridos</span>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombres</label>
                    <input name="UsuarioNombres" id="inputNombres" class="form-control"
                           placeholder="Ej. Dylan Gabriel" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Apellidos</label>
                    <input name="UsuarioApellidos" id="inputApellidos" class="form-control"
                           placeholder="Ej. Rosales Cabrera" required />
                </div>
            </div>
        </div>

        <!-- Credenciales -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 fw-semibold mb-0">Credenciales de acceso</h3>
                <span class="text-muted small">Campos obligatorios</span>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Username</label>
                    <input name="UsuarioUsername" id="inputUsername"
                           class="form-control" readonly
                           style="background:#f8fdfb; color:#1a5c38; font-weight:600;" />
                    <div class="form-text">Se genera automáticamente.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Correo electrónico</label>
                    <input name="UsuarioEmail" id="inputEmail" type="email"
                           class="form-control" readonly required
                           style="background:#f8fdfb; color:#1a5c38; font-weight:600;" />
                    <div class="form-text">Se genera automáticamente.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Contraseña</label>
                    <input name="UsuarioPassword" type="password" class="form-control"
                           placeholder="Mínimo 6 caracteres" required />
                    <div class="form-text">Se almacenará cifrada.</div>
                </div>
            </div>
        </div>

        <!-- Rol -->
        <div class="mb-4">
            <h3 class="h6 fw-semibold mb-2">Rol del sistema</h3>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Rol</label>
                    <select name="RolId" id="selectRol" class="form-select" required
                            onchange="toggleCamposMedico()">
                        <option value="">-- Seleccionar rol --</option>
                        @foreach (var item in ViewBag.Roles as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- ── Datos del médico (solo si rol = Médico) ── -->
        <div id="seccionMedico" style="display:none;">
            <hr class="my-3" />
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <h3 class="h6 fw-semibold mb-0" style="color:#1a5c38;">
                        👨‍⚕️ Datos del médico
                    </h3>
                    <span class="badge bg-success-subtle text-success border border-success-subtle small">
                        Requerido para rol Médico
                    </span>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Especialidad</label>
                        <select name="EspecialidadId" id="selectEspecialidad"
                                class="form-select">
                            <option value="">-- Seleccionar especialidad --</option>
                            @if (ViewBag.Especialidades != null)
                            {
                                @foreach (var item in ViewBag.Especialidades as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">No. de colegiado</label>
                        <input name="MedicoColegiado" class="form-control"
                               placeholder="Ej. 12345" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Teléfono</label>
                        <input name="MedicoTelefono" class="form-control"
                               placeholder="Ej. 5555-1234" />
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">Crear usuario</button>
            <a asp-action="Usuarios" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const inputNombres   = document.getElementById('inputNombres');
        const inputApellidos = document.getElementById('inputApellidos');
        const inputUsername  = document.getElementById('inputUsername');
        const inputEmail     = document.getElementById('inputEmail');

        function limpiar(str) {
            return str
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9]/g, '');
        }

        function generarUsername() {
            const nombres   = (inputNombres.value   || '').trim();
            const apellidos = (inputApellidos.value || '').trim();

            if (!nombres || !apellidos) {
                inputUsername.value = '';
                inputEmail.value    = '';
                return;
            }

            const primerNombre   = nombres.split(' ')[0];
            const iniciaNombre   = limpiar(primerNombre[0].toLowerCase());
            const partesApellido = apellidos.split(' ').filter(a => a.length > 0);
            const primerApellido = limpiar(partesApellido[0]?.toLowerCase() || '');
            const iniciaSegundo  = limpiar(partesApellido[1]?.[0]?.toLowerCase() || '');

            const username = iniciaNombre + primerApellido + iniciaSegundo;
            inputUsername.value = username;
            inputEmail.value    = username + '\u0040civs.com';
        }

        inputNombres.addEventListener('input', generarUsername);
        inputApellidos.addEventListener('input', generarUsername);

        // ── Mostrar/ocultar sección médico según el rol ──────────────────────
        function toggleCamposMedico() {
            const select   = document.getElementById('selectRol');
            const opcion   = select.options[select.selectedIndex];
            const esMedico = opcion.text.toLowerCase().includes('medico') ||
                             opcion.text.toLowerCase().includes('médico');

            const seccion    = document.getElementById('seccionMedico');
            const espSelect  = document.getElementById('selectEspecialidad');
            const colegiado  = document.querySelector('[name="MedicoColegiado"]');
            const telefono   = document.querySelector('[name="MedicoTelefono"]');

            if (esMedico) {
                seccion.style.display   = 'block';
                espSelect.required      = true;
                colegiado.required      = true;
                telefono.required       = true;
            } else {
                seccion.style.display   = 'none';
                espSelect.required      = false;
                colegiado.required      = false;
                telefono.required       = false;
                espSelect.value         = '';
                colegiado.value         = '';
                telefono.value          = '';
            }
        }

        // Auto-cerrar toast
        setTimeout(function () {
            const alertEl = document.querySelector('.alert.alert-success');
            if (alertEl) bootstrap.Alert.getOrCreateInstance(alertEl).close();
        }, 3000);
    </script>
}