@model List<CIVS.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";

    int? rolIdSeleccionado = null;

    if (ViewBag.RolId != null)
    {
        rolIdSeleccionado = Convert.ToInt32(ViewBag.RolId);
    }
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="bg-white border rounded-4 shadow-sm p-4 mt-3">

    <!-- Encabezado -->
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill"
                      style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                    Administración
                </span>
                <span class="text-muted small">Usuarios del sistema</span>
            </div>

            <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                Gestión de usuarios
            </h2>

            <p class="text-muted mb-0">
                Consultá los usuarios registrados y filtrá la lista por rol del sistema.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="CrearUsuario" class="btn btn-primary">
                + Nuevo usuario
            </a>
        </div>
    </div>

    <hr class="my-3" />

    <!-- Filtro por rol -->
    <form asp-action="Usuarios" method="get" class="row g-2 align-items-end mb-4">
        <div class="col-12 col-md-4">
            <label class="form-label fw-semibold small">Filtrar por rol</label>
            <select name="rolId"
                    asp-items="ViewBag.RolesFiltro"
                    class="form-select"
                    onchange="this.form.submit()">
                <option value="">Todos los roles</option>
            </select>
            <div class="form-text">
                Seleccioná un rol para ver únicamente los usuarios asignados a ese perfil.
            </div>
        </div>

        <div class="col-12 col-md-auto">
            <a asp-action="Usuarios" class="btn btn-outline-secondary w-100">
                Limpiar filtro
            </a>
        </div>
    </form>

    <!-- Estado del filtro -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            @if (rolIdSeleccionado.HasValue && rolIdSeleccionado.Value > 0)
            {
                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">
                    Filtro activo por rol
                </span>
            }
            else
            {
                <span class="badge rounded-pill"
                      style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                    Mostrando todos los roles
                </span>
            }
        </div>

        <span class="text-muted small">
            @(Model?.Count ?? 0) usuario(s) encontrado(s)
        </span>
    </div>

    <!-- Resultados -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-light border mb-0 text-center text-muted">
            No hay usuarios registrados con el rol seleccionado.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Nombre completo</th>
                        <th>Correo</th>
                        <th>Roles</th>
                        <th>Fecha registro</th>
                        <th>Estado</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var u in Model)
                    {
                        var rolesActivos = u.UsuarioRoles?
                        .Where(r => r.UsuarioRolEstado)
                        .Select(r => r.Rol.RolNombre)
                        .ToList() ?? new List<string>();

                        <tr>
                            <td class="fw-semibold">
                                @u.UsuarioUsername
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(u.UsuarioNombres) &&
                                                        string.IsNullOrWhiteSpace(u.UsuarioApellidos))
                                {
                                    <span class="text-muted small">Sin nombre registrado</span>
                                }
                                else
                                {
                                    <span>@u.UsuarioNombres @u.UsuarioApellidos</span>
                                }
                            </td>

                            <td class="text-muted small">
                                @if (string.IsNullOrWhiteSpace(u.UsuarioEmail))
                                {
                                    <span>Sin correo</span>
                                }
                                else
                                {
                                    <span>@u.UsuarioEmail</span>
                                }
                            </td>

                            <td>
                                @if (rolesActivos.Any())
                                {
                                    foreach (var rol in rolesActivos)
                                    {
                                        <span class="badge rounded-pill me-1"
                                              style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                                            @rol
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Sin rol</span>
                                }
                            </td>

                            <td class="text-muted small">
                                @u.UsuarioFechaRegistro.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @if (u.UsuarioEstado)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <form asp-action="ActivarDesactivar" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.UsuarioId" />

                                    <button type="submit"
                                            class="btn btn-sm @(u.UsuarioEstado ? "btn-outline-secondary" : "btn-outline-success")"
                                            onclick="return confirm('@(u.UsuarioEstado ? "¿Desactivar este usuario?" : "¿Activar este usuario?")')">
                                        @(u.UsuarioEstado ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted small mb-0 mt-2">
            Se encontraron @Model.Count usuario(s).
        </p>
    }
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            document.querySelectorAll('.alert.alert-success, .alert.alert-danger')
                .forEach(function (alertEl) {
                    bootstrap.Alert.getOrCreateInstance(alertEl).close();
                });
        }, 3000);
    </script>
}