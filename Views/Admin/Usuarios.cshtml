@model List<CIVS.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
    var q = ViewBag.Q as string;
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="bg-white border rounded-4 shadow-sm p-4 mt-3">

    <!-- Encabezado -->
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill"
                      style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                    Administración
                </span>
                <span class="text-muted small">Usuarios</span>
            </div>
            <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                Gestión de usuarios
            </h2>
            <p class="text-muted mb-0">
                Buscá por username, correo, nombre o apellido.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CrearUsuario" class="btn btn-primary">+ Nuevo usuario</a>
        </div>
    </div>

    <hr class="my-3" />

    <!-- Buscador -->
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-12 col-md-6">
            <label class="form-label">Buscar</label>
            <input name="q" value="@q" class="form-control"
                   placeholder="Ej. admin, correo@civs.com, Juan..." />
        </div>
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-outline-primary w-100">Buscar</button>
        </div>
        <div class="col-12 col-md-auto">
            <a asp-action="Usuarios" class="btn btn-outline-secondary w-100">Limpiar</a>
        </div>
    </form>

    <!-- Resultados -->
    @if (string.IsNullOrWhiteSpace(q))
    {
        <div class="alert alert-light border mb-0">
            Ingresá un término de búsqueda para consultar usuarios.
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-light border mb-0">
            No se encontraron usuarios para: <strong>@q</strong>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Nombre completo</th>
                        <th>Correo</th>
                        <th>Roles</th>
                        <th>Fecha registro</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.UsuarioUsername</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(u.UsuarioNombres)
                                                        ? "-"
                                                        : $"{u.UsuarioNombres} {u.UsuarioApellidos}")
                    </td>
                    <td class="text-muted small">@u.UsuarioEmail</td>
                    <td>
                        @foreach (var ur in u.UsuarioRoles.Where(r => r.UsuarioRolEstado))
                                {
                                    <span class="badge rounded-pill me-1"
                                          style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                                        @ur.Rol.RolNombre
                                    </span>
                                }
                                @if (!u.UsuarioRoles.Any(r => r.UsuarioRolEstado))
                                {
                                    <span class="text-muted small">Sin rol</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @u.UsuarioFechaRegistro.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @if (u.UsuarioEstado)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        Inactivo
                                    </span>
                                }
                            </td>
                            <td>
                                <form asp-action="ActivarDesactivar" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.UsuarioId" />
                                    <button type="submit"
                                            class="btn btn-sm @(u.UsuarioEstado ? "btn-outline-secondary" : "btn-outline-success")"
                                            onclick="return confirm('@(u.UsuarioEstado ? "¿Desactivar este usuario?" : "¿Activar este usuario?")')">
                                        @(u.UsuarioEstado ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mb-0 mt-2">
            @Model.Count usuario(s) encontrado(s) para «@q».
        </p>
    }
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            const alertEl = document.querySelector('.alert.alert-success');
            if (alertEl) bootstrap.Alert.getOrCreateInstance(alertEl).close();
        }, 3000);
    </script>
}