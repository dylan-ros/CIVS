@model List<CIVS.Models.Auditoria>

@{
    ViewData["Title"] = "Bitácora de auditoría";
    var q = ViewBag.Q as string;
    var accion = ViewBag.Accion as string;
    var desde = ViewBag.Desde as string;
    var hasta = ViewBag.Hasta as string;
}

<div class="bg-white border rounded-4 shadow-sm p-4 mt-3">

    <!-- Encabezado -->
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill"
                      style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                    Administración
                </span>
                <span class="text-muted small">Bitácora</span>
            </div>
            <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                Bitácora de auditoría
            </h2>
            <p class="text-muted mb-0">
                Registro de todas las acciones críticas del sistema. Máximo 500 registros por consulta.
            </p>
        </div>
    </div>

    <hr class="my-3" />

    <!-- Filtros -->
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-12 col-md-3">
            <label class="form-label">Buscar</label>
            <input name="q" value="@q" class="form-control"
                   placeholder="Entidad, usuario, descripción..." />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">Acción</label>
            <select name="accion" class="form-select">
                <option value="">Todas</option>
                <option value="LOGIN" selected="@(accion == "LOGIN")">LOGIN</option>
                <option value="LOGOUT" selected="@(accion == "LOGOUT")">LOGOUT</option>
                <option value="CREATE" selected="@(accion == "CREATE")">CREATE</option>
                <option value="UPDATE" selected="@(accion == "UPDATE")">UPDATE</option>
                <option value="DELETE" selected="@(accion == "DELETE")">DELETE</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">Desde</label>
            <input type="date" name="desde" value="@desde" class="form-control" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label">Hasta</label>
            <input type="date" name="hasta" value="@hasta" class="form-control" />
        </div>
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
        </div>
        <div class="col-12 col-md-auto">
            <a asp-action="Auditoria" class="btn btn-outline-secondary w-100">Limpiar</a>
        </div>
    </form>

    <!-- Resultados -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-light border mb-0">
            No se encontraron registros con los filtros aplicados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Acción</th>
                        <th>Entidad</th>
                        <th>ID afectado</th>
                        <th>Usuario</th>
                        <th>Descripción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="text-muted small">
                                @a.AuditoriaFecha.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @switch (a.AuditoriaAccion)
                                {
                                    case "LOGIN":
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">LOGIN</span>
                                        break;
                                    case "LOGOUT":
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">LOGOUT</span>
                                        break;
                                    case "CREATE":
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">CREATE</span>
                                        break;
                                    case "UPDATE":
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">UPDATE</span>
                                        break;
                                    case "DELETE":
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">DELETE</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark border">@a.AuditoriaAccion</span>
                                        break;
                                }
                        </td>
                        <td class="fw-semibold">@a.AuditoriaEntidad</td>
                        <td class="text-muted small">
                            @(string.IsNullOrWhiteSpace(a.AuditoriaEntidadId) ? "—" : a.AuditoriaEntidadId)
                        </td>
                        <td>
                            @(a.Usuario != null ? a.Usuario.UsuarioUsername : "Sistema")
                        </td>
                        <td class="text-muted small">
                            @(string.IsNullOrWhiteSpace(a.AuditoriaDescripcion)
                                                    ? "—"
                                                    : (a.AuditoriaDescripcion.Length > 80
                                                    ? a.AuditoriaDescripcion[..80] + "..."
                                                    : a.AuditoriaDescripcion))
                    </td>
                </tr>
                                }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mb-0 mt-2">
            @Model.Count registro(s) encontrado(s).
        </p>
    }
</div>