@model CIVS.Models.Consulta

@{
    ViewData["Title"] = "Detalle de consulta";
    var diagnosticos = ViewBag.Diagnosticos as List<CIVS.Models.ConsultaDiagnostico>;
    var recetas = ViewBag.Recetas as List<CIVS.Models.Receta>;
    var ordenes = ViewBag.Ordenes as List<CIVS.Models.OrdenExamen>;
    var medicamentosJson = ViewBag.MedicamentosJson as string;
    var diagJson = ViewBag.DiagnosticosJson as string;
    int? facturaId = ViewBag.FacturaId;
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed;top:20px;right:20px;z-index:9999;min-width:320px;max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="position:fixed;top:20px;right:20px;z-index:9999;min-width:320px;max-width:420px;">
        <div class="alert alert-danger alert-dismissible fade show shadow">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<div class="row g-3 mt-1">

    <!-- ── Columna izquierda: ficha ── -->
    <div class="col-lg-3">
        <div class="bg-white border rounded-4 shadow-sm p-4">

            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="badge rounded-pill"
                      style="background:#e9f7ef;color:#1e7e34;border:1px solid #cfeedd;">
                    Consulta #@Model.ConsultaId
                </span>
            </div>

            <!-- Paciente -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <div style="width:42px;height:42px;border-radius:50%;
                            background:linear-gradient(135deg,#e8f5ee,#d1fae5);
                            display:flex;align-items:center;justify-content:center;
                            font-weight:700;color:#1a5c38;font-size:.9rem;flex-shrink:0;">
                    @Model.Cita.Paciente!.PacienteNombres[0]@Model.Cita.Paciente.PacienteApellido[0]
                </div>
                <div>
                    <p class="fw-bold mb-0 small" style="color:#1a2e22;">
                        @Model.Cita.Paciente.PacienteNombres @Model.Cita.Paciente.PacienteApellido
                    </p>
                    <p class="text-muted mb-0" style="font-size:.72rem;">
                        @Model.Cita.Paciente.PacienteDPI
                    </p>
                </div>
            </div>

            <div class="d-flex flex-column gap-1 small mb-3">
                <div>
                    <span class="text-muted">Médico: </span>
                    <span class="fw-semibold">
                        Dr. @Model.Cita.Medico!.MedicoNombres @Model.Cita.Medico.MedicoApellidos
                    </span>
                </div>
                <div>
                    <span class="text-muted">Especialidad: </span>
                    <span class="fw-semibold">
                        @(Model.Cita.Medico.Especialidad?.EspecialidadNombre ?? "—")
                    </span>
                </div>
                <div>
                    <span class="text-muted">Fecha: </span>
                    <span class="fw-semibold">
                        @Model.ConsultaFechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>
            </div>

            <hr class="my-3" />

            <p class="text-muted small fw-semibold mb-1">Signos vitales</p>
            <p class="small mb-3">@Model.ConsultaSignosVitales</p>

            <p class="text-muted small fw-semibold mb-1">Notas clínicas</p>
            <p class="small mb-3">@Model.ConsultaNotasClinicas</p>

            <p class="text-muted small fw-semibold mb-1">Plan de tratamiento</p>
            <p class="small mb-0">@Model.ConsultaPlanTratamiento</p>
        </div>
    </div>

    <!-- ── Columna derecha: acciones ── -->
    <div class="col-lg-9">
        <div class="d-flex flex-column gap-3">

            <!-- ── Diagnósticos ── -->
            <div class="bg-white border rounded-4 shadow-sm p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h3 class="h6 fw-semibold mb-0" style="color:#1a5c38;">🩺 Diagnósticos</h3>
                    @if (facturaId == null)
                    {
                        <button class="btn btn-sm btn-outline-success"
                                onclick="toggleSeccion('formDiagnostico')">
                            + Agregar diagnóstico
                        </button>
                    }
                </div>

                @if (diagnosticos != null && diagnosticos.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var d in diagnosticos)
                        {
                            <div class="d-flex align-items-center gap-2 border rounded-3 px-3 py-2"
                                 style="background:#f8fdfb;">
                                <span class="small fw-semibold" style="color:#1a5c38;">
                                    @d.Diagnostico.DiagnosticoCodigo
                                </span>
                                <span class="small text-muted">@d.Diagnostico.DiagnosticoNombre</span>
                                @if (d.EsPrincipal)
                                {
                                    <span class="badge bg-success-subtle text-success"
                                          style="font-size:.65rem;">Principal</span>
                                }
                                @if (facturaId == null)
                                {
                                    <form asp-action="EliminarDiagnostico" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="consultaDiagnosticoId"
                                               value="@d.ConsultaDiagnosticoId" />
                                        <input type="hidden" name="consultaId"
                                               value="@Model.ConsultaId" />
                                        <button type="submit" class="btn-close"
                                                style="font-size:.6rem;"></button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">Sin diagnósticos registrados.</p>
                }

                <div id="formDiagnostico" style="display:none;">
                    <form asp-action="AgregarDiagnostico" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ConsultaId" value="@Model.ConsultaId" />
                        <div class="row g-2 align-items-end">
                            <div class="col-md-5 position-relative">
                                <label class="form-label small">Buscar diagnóstico (CIE-10)</label>
                                <input type="text" id="buscarDiagnostico"
                                       class="form-control form-control-sm"
                                       placeholder="Código o nombre..." autocomplete="off" />
                                <input type="hidden" name="DiagnosticoId"
                                       id="diagnosticoIdSeleccionado" />
                                <div id="resultadosDiagnostico"
                                     style="display:none;position:absolute;z-index:1050;
                                            background:#fff;border:1.5px solid #d4e4da;
                                            border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.1);
                                            max-height:200px;overflow-y:auto;width:100%;">
                                </div>
                                <div id="diagSeleccionadoBadge" style="display:none;"
                                     class="mt-1 px-2 py-1 rounded-3 small fw-semibold"
                                     style="background:#f0faf4;color:#1a5c38;"></div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Tipo</label>
                                <select name="EsPrincipal" class="form-select form-select-sm">
                                    <option value="false">Secundario</option>
                                    <option value="true">Principal</option>
                                </select>
                            </div>
                            <div class="col-md-auto">
                                <button type="submit" class="btn btn-success btn-sm">Agregar</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        onclick="toggleSeccion('formDiagnostico')">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ── Receta médica ── -->
            <div class="bg-white border rounded-4 shadow-sm p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h3 class="h6 fw-semibold mb-0" style="color:#1a5c38;">💊 Receta médica</h3>
                    @if (facturaId == null)
                    {
                        <button class="btn btn-sm btn-outline-success"
                                onclick="toggleSeccion('seccionReceta')">
                            + Nueva receta
                        </button>
                    }
                </div>

                @if (recetas != null && recetas.Any())
                {
                    @foreach (var r in recetas)
                    {
                        <div class="border rounded-3 p-3 mb-2" style="background:#f8fdfb;">
                            <p class="small text-muted mb-2">
                                Emitida: @r.RecetaFechaEmision.ToString("dd/MM/yyyy HH:mm")
                                @if (!string.IsNullOrWhiteSpace(r.RecetaObservaciones))
                                {
                                    <span> — @r.RecetaObservaciones</span>
                                }
                            </p>
                            @foreach (var rd in r.RecetaDetalles)
                            {
                                <div class="d-flex align-items-start gap-2 mb-1 small">
                                    <span class="fw-semibold" style="color:#1a5c38;min-width:160px;">
                                        @rd.Medicamento.MedicamentoNombre
                                    </span>
                                    <span class="text-muted">
                                        @rd.Dosis — @rd.Frecuencia — @rd.Duracion
                                        @if (!string.IsNullOrWhiteSpace(rd.Indicaciones))
                                        {
                                            <em> (@rd.Indicaciones)</em>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small mb-3">Sin recetas generadas.</p>
                }

                <div id="seccionReceta" style="display:none;">
                    <form asp-action="GenerarReceta" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ConsultaId" value="@Model.ConsultaId" />
                        <div class="mb-2">
                            <input name="RecetaObservaciones" class="form-control form-control-sm"
                                   placeholder="Observaciones generales (opcional)" />
                        </div>
                        <div id="contenedorMedicamentos"></div>
                        <div class="alert alert-light border text-center text-muted small"
                             id="avisoMedicamentos">
                            Clic en "+ Medicamento" para agregar
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn btn-outline-success btn-sm"
                                    onclick="agregarMedicamento()">
                                + Medicamento
                            </button>
                            <button type="submit" class="btn btn-success btn-sm">
                                Guardar receta
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ── Órdenes de examen ── -->
            <div class="bg-white border rounded-4 shadow-sm p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h3 class="h6 fw-semibold mb-0" style="color:#1a5c38;">🔬 Órdenes de examen</h3>
                    @if (facturaId == null)
                    {
                        <button class="btn btn-sm btn-outline-success"
                                onclick="toggleSeccion('seccionOrden')">
                            + Nueva orden
                        </button>
                    }
                </div>

                @if (ordenes != null && ordenes.Any())
                {
                    @foreach (var o in ordenes)
                    {
                        <div class="d-flex align-items-center justify-content-between
                                            border rounded-3 px-3 py-2 mb-2"
                             style="background:#f8fdfb;">
                            <div>
                                <span class="small fw-semibold" style="color:#1a5c38;">
                                    @o.Examen.ExamenNombre
                                </span>
                                <span class="text-muted small ms-2">
                                    @o.OrdenFecha.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                            @switch (o.OrdenEstado)
                            {
                                case CIVS.Models.EstadoOrdenExamen.Solicitado:
                                    <span class="badge bg-warning-subtle text-warning
                                                                 border border-warning-subtle small">Solicitado</span>
                                    break;
                                case CIVS.Models.EstadoOrdenExamen.Entregado:
                                    <span class="badge bg-success-subtle text-success
                                                                 border border-success-subtle small">Entregado</span>
                                    break;
                                default:
                                    <span class="badge bg-info-subtle text-info
                                                                 border border-info-subtle small">@o.OrdenEstado</span>
                                    break;
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small mb-3">Sin órdenes generadas.</p>
                }

                <div id="seccionOrden" style="display:none;">
                    <form asp-action="GenerarOrden" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ConsultaId" value="@Model.ConsultaId" />
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small">Tipo de examen</label>
                                <select name="ExamenId" asp-items="ViewBag.Examenes"
                                        class="form-select form-select-sm" required>
                                    <option value="">-- Seleccionar --</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small">Observaciones</label>
                                <input name="Observaciones" class="form-control form-control-sm"
                                       placeholder="Indicaciones especiales..." />
                            </div>
                            <div class="col-md-auto">
                                <button type="submit" class="btn btn-success btn-sm">
                                    Generar orden
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ── Cita de seguimiento ── -->
            <div class="bg-white border rounded-4 shadow-sm p-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h3 class="h6 fw-semibold mb-0" style="color:#1a5c38;">📅 Cita de seguimiento</h3>
                    <button class="btn btn-sm btn-outline-success"
                            onclick="toggleSeccion('seccionSeguimiento')">
                        + Agendar seguimiento
                    </button>
                </div>
                <p class="text-muted small mb-0">
                    Agendá una nueva cita de seguimiento para este paciente.
                </p>

                <div id="seccionSeguimiento" style="display:none;" class="mt-3">
                    <form asp-action="AgendarSeguimiento" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ConsultaId" value="@Model.ConsultaId" />
                        <input type="hidden" name="PacienteId"
                               value="@Model.Cita.PacienteId" />
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small">Médico</label>
                                <select name="MedicoId" asp-items="ViewBag.MedicosSeguimiento"
                                        class="form-select form-select-sm" required>
                                    <option value="">-- Seleccionar --</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Fecha y hora inicio</label>
                                <input type="datetime-local" name="FechaInicio"
                                       class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Fecha y hora fin</label>
                                <input type="datetime-local" name="FechaFin"
                                       class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small">Motivo</label>
                                <input name="Motivo" class="form-control form-control-sm"
                                       placeholder="Ej. Seguimiento gripe, Revisión resultados..."
                                       required />
                            </div>
                            <div class="col-md-auto d-flex align-items-end">
                                <button type="submit" class="btn btn-success btn-sm">
                                    Agendar
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ── Finalizar y cobrar ── -->
            <div class="bg-white border rounded-4 shadow-sm p-4">
                @if (facturaId != null)
                {
                    <!-- Ya tiene factura → ir al pago -->
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h3 class="h6 fw-semibold mb-1" style="color:#1a5c38;">
                                🧾 Factura generada
                            </h3>
                            <p class="text-muted small mb-0">
                                Esta consulta ya tiene una factura. Podés ir al pago.
                            </p>
                        </div>
                        <a asp-action="Pago" asp-route-id="@facturaId"
                           class="btn btn-primary">
                            Ir al pago →
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h3 class="h6 fw-semibold mb-1" style="color:#1a5c38;">
                                🧾 Finalizar consulta
                            </h3>
                            <p class="text-muted small mb-0">
                                Generá la factura con todos los servicios de esta consulta.
                            </p>
                        </div>
                        <form asp-action="FinalizarYCobrar" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ConsultaId" value="@Model.ConsultaId" />
                            <button type="submit" class="btn btn-primary"
                                    onclick="return confirm('¿Finalizar la consulta y generar factura?')">
                                Finalizar y cobrar →
                            </button>
                        </form>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const medicamentosData = @Html.Raw(medicamentosJson ?? "[]");
        const diagnosticosData = @Html.Raw(diagJson ?? "[]");
        let indiceMed = 0;

        function toggleSeccion(id) {
            const el = document.getElementById(id);
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
        }

        // ── Buscador diagnóstico ──────────────────────────────────────────────
        document.getElementById('buscarDiagnostico')
                ?.addEventListener('input', function () {
            const q   = this.value.trim().toLowerCase();
            const res = document.getElementById('resultadosDiagnostico');
            if (q.length < 2) { res.style.display = 'none'; return; }

            const filtrados = diagnosticosData
                .filter(d => d.codigo.toLowerCase().includes(q) ||
                             d.nombre.toLowerCase().includes(q))
                .slice(0, 8);

            if (!filtrados.length) {
                res.innerHTML = `<div class="px-3 py-2 text-muted small">Sin resultados</div>`;
            } else {
                res.innerHTML = filtrados.map(d => `
                    <div class="px-3 py-2 small"
                         style="cursor:pointer;border-bottom:1px solid #f0f4f2;"
                         onmouseenter="this.style.background='#f0faf4'"
                         onmouseleave="this.style.background=''"
                         onclick="seleccionarDiag(${d.id},'${d.codigo}',
                                  '${d.nombre.replace(/'/g,"\\'")}')">
                        <span class="fw-semibold" style="color:#1a5c38;">${d.codigo}</span>
                        <span class="text-muted ms-2">${d.nombre}</span>
                    </div>`).join('');
            }
            res.style.display = 'block';
        });

        function seleccionarDiag(id, codigo, nombre) {
            document.getElementById('diagnosticoIdSeleccionado').value = id;
            document.getElementById('buscarDiagnostico').style.display = 'none';
            document.getElementById('resultadosDiagnostico').style.display = 'none';
            const badge = document.getElementById('diagSeleccionadoBadge');
            badge.textContent    = `${codigo} — ${nombre}`;
            badge.style.display  = 'block';
            badge.style.background = '#f0faf4';
            badge.style.color      = '#1a5c38';
        }

        // ── Agregar línea de medicamento ──────────────────────────────────────
        function agregarMedicamento() {
            document.getElementById('avisoMedicamentos').style.display = 'none';
            const contenedor = document.getElementById('contenedorMedicamentos');
            const opciones   = medicamentosData.map(m =>
                `<option value="${m.id}">${m.nombre}
                 ${m.presentacion ? '— ' + m.presentacion : ''}
                 ${m.concentracion ? m.concentracion : ''}</option>`
            ).join('');

            const div = document.createElement('div');
            div.className = 'border rounded-3 p-2 mb-2 bg-light position-relative';
            div.innerHTML = `
                <button type="button" class="btn-close position-absolute top-0 end-0 m-1"
                        style="font-size:.6rem;"
                        onclick="this.parentElement.remove()"></button>
                <div class="row g-2">
                    <div class="col-md-4">
                        <select name="MedicamentoId" class="form-select form-select-sm" required>
                            <option value="">-- Medicamento --</option>${opciones}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input name="Dosis" class="form-control form-control-sm"
                               placeholder="Dosis" />
                    </div>
                    <div class="col-md-2">
                        <input name="Frecuencia" class="form-control form-control-sm"
                               placeholder="Frecuencia" />
                    </div>
                    <div class="col-md-2">
                        <input name="Duracion" class="form-control form-control-sm"
                               placeholder="Duración" />
                    </div>
                    <div class="col-md-2">
                        <input name="Indicaciones" class="form-control form-control-sm"
                               placeholder="Indicaciones" />
                    </div>
                </div>`;
            contenedor.appendChild(div);
            indiceMed++;
        }

        // Auto-cerrar toasts
        setTimeout(() => {
            document.querySelectorAll('.alert.alert-success, .alert.alert-danger')
                    .forEach(a => bootstrap.Alert.getOrCreateInstance(a)?.close());
        }, 4000);
    </script>
}