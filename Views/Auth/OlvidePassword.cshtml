@{
    Layout = null;
    ViewData["Title"] = "Olvidé mi contraseña";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CIVS — Recuperar contraseña</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: flex;
            background: #f4f7f5;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .panel-izq {
            flex: 1;
            background: linear-gradient(160deg, #1a5c38 0%, #2d8653 60%, #3cb371 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            padding: 60px 56px;
            position: relative;
            overflow: hidden;
        }

            .panel-izq::before {
                content: '';
                position: absolute;
                top: -80px;
                right: -80px;
                width: 340px;
                height: 340px;
                border-radius: 50%;
                background: rgba(255,255,255,.06);
            }

        .logo-marca {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 56px;
            position: relative;
            z-index: 1;
        }

        .logo-sigla {
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            background: rgba(255,255,255,.15);
            border: 1.5px solid rgba(255,255,255,.3);
            border-radius: 12px;
            padding: 6px 16px;
            letter-spacing: 3px;
        }

        .logo-texto span:first-child {
            font-size: .7rem;
            font-weight: 500;
            color: rgba(255,255,255,.65);
            letter-spacing: 2px;
            text-transform: uppercase;
            display: block;
        }

        .logo-texto span:last-child {
            font-size: 1.1rem;
            font-weight: 600;
            color: #fff;
        }

        .panel-titulo {
            font-size: 2.6rem;
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
            margin-bottom: 16px;
            position: relative;
            z-index: 1;
        }

        .panel-der {
            width: 460px;
            min-height: 100vh;
            background: #fff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px 48px;
            box-shadow: -8px 0 40px rgba(0,0,0,.08);
            animation: slideIn .4s ease both;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .form-label {
            font-size: .78rem;
            font-weight: 700;
            color: #1a2e22;
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .form-control {
            border: 1.5px solid #d4e4da;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: .92rem;
            background: #f4f7f5;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }

            .form-control:focus {
                border-color: #2d8653;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(45,134,83,.12);
                outline: none;
            }

        .btn-primary {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #1a5c38, #2d8653);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-weight: 700;
            font-size: .95rem;
            cursor: pointer;
            transition: opacity .2s;
            margin-top: 8px;
        }

            .btn-primary:hover {
                opacity: .9;
            }

        .alerta-error {
            background: #fff5f5;
            border: 1.5px solid #fcc;
            border-radius: 10px;
            padding: 12px 16px;
            color: #c53030;
            font-size: .85rem;
            margin-bottom: 20px;
        }

        .alerta-success {
            background: #f0fdf4;
            border: 1.5px solid #86efac;
            border-radius: 10px;
            padding: 12px 16px;
            color: #166534;
            font-size: .85rem;
            margin-bottom: 20px;
            word-break: break-all;
        }

        .btn-volver {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #2d8653;
            text-decoration: none;
            font-size: .85rem;
            margin-top: 20px;
            transition: color .2s;
        }

            .btn-volver:hover {
                color: #1a5c38;
            }

        @@media (max-width: 900px) {
            .panel-izq {
                display: none;
            }

            .panel-der {
                width: 100%;
                padding: 48px 32px;
            }
        }
    </style>
</head>
<body>

    <div class="panel-izq d-none d-md-flex flex-column">
        <div class="logo-marca">
            <span class="logo-sigla">CIVS</span>
            <div class="logo-texto">
                <span>Sistema ERP</span>
                <span>Clínica Integral<br>Vida Sana</span>
            </div>
        </div>
        <h2 class="panel-titulo">Recuperá tu<br>acceso al sistema.</h2>
    </div>

    <div class="panel-der">
        <h1 style="font-size:1.9rem;font-weight:700;color:#1a2e22;margin-bottom:6px;">
            ¿Olvidaste tu contraseña?
        </h1>
        <p style="color:#6b8f7a;font-size:.88rem;margin-bottom:32px;">
            Ingresá tu correo electrónico y te generaremos un enlace de recuperación
        </p>

        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="alerta-error">
                ⚠️ @ViewBag.Error
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewBag.Success as string))
        {
            <div class="alerta-success">
                ✅ @Html.Raw(ViewBag.Success)
            </div>
        }

        <form asp-action="OlvidePassword" asp-controller="Auth" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <input type="email" name="email"
                       class="form-control"
                       placeholder="tu-correo@civs.com"
                       autocomplete="email" autofocus required />
            </div>

            <button type="submit" class="btn-primary">Generar enlace de recuperación</button>
        </form>

        <a href="@Url.Action("Login", "Auth")" class="btn-volver">
            ← Volver al inicio de sesión
        </a>

        <p class="text-center text-muted mt-4 mb-0" style="font-size:.75rem;">
            &copy; 2026 — CIVS · Clínica Integral Vida Sana, S.A.
        </p>
    </div>

</body>
</html>