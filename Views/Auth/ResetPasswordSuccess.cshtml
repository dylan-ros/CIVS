@{
    Layout = null;
    ViewData["Title"] = "Contraseña actualizada";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CIVS — Contraseña actualizada</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(160deg, #1a5c38 0%, #2d8653 60%, #3cb371 100%);
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .success-card {
            background: #fff;
            border-radius: 20px;
            padding: 48px;
            max-width: 480px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0,0,0,.25);
            animation: fadeInUp .5s ease both;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .check-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #1a5c38, #2d8653);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

            .check-icon svg {
                width: 48px;
                height: 48px;
                color: #fff;
            }

        h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: #1a2e22;
            margin-bottom: 12px;
        }

        p {
            color: #6b8f7a;
            font-size: .95rem;
            line-height: 1.6;
            margin-bottom: 32px;
        }

        .btn-login {
            display: inline-block;
            padding: 12px 32px;
            background: linear-gradient(135deg, #1a5c38, #2d8653);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-weight: 700;
            font-size: .95rem;
            text-decoration: none;
            transition: opacity .2s;
        }

            .btn-login:hover {
                opacity: .9;
                color: #fff;
            }

        .countdown {
            margin-top: 20px;
            font-size: .85rem;
            color: #9ca3af;
        }
    </style>
</head>
<body>

    <div class="success-card">
        <div class="check-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h1>¡Contraseña actualizada!</h1>
        <p>
            Tu contraseña ha sido cambiada exitosamente.<br>
            Ya podés iniciar sesión con tu nueva contraseña.
        </p>

        <a href="@Url.Action("Login", "Auth")" class="btn-login">
            Ir a iniciar sesión
        </a>

        <p class="countdown">
            Serás redirigido automáticamente en <span id="segundos">5</span> segundos...
        </p>
    </div>

    <script>
        let segundos = 5;
        const spanSegundos = document.getElementById('segundos');

        const intervalo = setInterval(() => {
            segundos--;
            spanSegundos.textContent = segundos;

            if (segundos <= 0) {
                clearInterval(intervalo);
                window.location.href = '@Url.Action("Login", "Auth")';
            }
        }, 1000);
    </script>

</body>
</html>