@model CIVS.Models.Factura

@{
    ViewData["Title"] = "Detalle de factura";
}

<div class="bg-white border rounded-4 shadow-sm p-4 mt-3">

    <!-- Encabezado -->
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill"
                      style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                    Corte de Caja
                </span>
                <span class="text-muted small">
                    Factura @(Model.FacturaNumero ?? $"#{Model.FacturaId}")
                </span>
            </div>
            <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34;">
                @Model.Paciente.PacienteNombres @Model.Paciente.PacienteApellido
            </h2>
            <p class="text-muted mb-0">
                Emitida el @Model.FacturaFecha.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>

        @switch (Model.FacturaEstado)
        {
            case CIVS.Models.EstadoFactura.Emitida:
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-6 px-3 py-2">Emitida</span>
                break;
            case CIVS.Models.EstadoFactura.Pagada:
                <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-2">Pagada</span>
                break;
            case CIVS.Models.EstadoFactura.Anulada:
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fs-6 px-3 py-2">Anulada</span>
                break;
        }
    </div>

    <hr class="my-3" />

    <!-- Info del paciente -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <p class="text-muted small mb-1">DPI</p>
            <p class="fw-semibold mb-0">@Model.Paciente.PacienteDPI</p>
        </div>
        <div class="col-md-3">
            <p class="text-muted small mb-1">Teléfono</p>
            <p class="fw-semibold mb-0">@Model.Paciente.PacienteTelefono</p>
        </div>
        @if (Model.Cita != null)
        {
            <div class="col-md-3">
                <p class="text-muted small mb-1">Médico</p>
                <p class="fw-semibold mb-0">
                    Dr. @Model.Cita.Medico.MedicoNombres @Model.Cita.Medico.MedicoApellidos
                </p>
            </div>
            <div class="col-md-3">
                <p class="text-muted small mb-1">Fecha de cita</p>
                <p class="fw-semibold mb-0">@Model.Cita.CitaFechaInicio.ToString("dd/MM/yyyy")</p>
            </div>
        }
    </div>

    <!-- Tabla de detalle -->
    <h3 class="h6 fw-semibold mb-3">Servicios facturados</h3>
    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Precio unit.</th>
                    <th class="text-end">Descuento</th>
                    <th class="text-end">Total línea</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>@d.DetalleDescripcion</td>
                        <td class="text-center">@d.DetalleCantidad</td>
                        <td class="text-end">Q @d.DetallePrecioUnitario.ToString("0.00")</td>
                        <td class="text-end">
                            @(d.DetalleDescuento > 0
                                                    ? $"Q {d.DetalleDescuento:0.00}"
                                                    : "—")
                    </td>
                    <td class="text-end fw-semibold">Q @d.DetalleTotalLinea.ToString("0.00")</td>
                </tr>
                                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="4" class="text-end fw-bold">Total</td>
                    <td class="text-end fw-bold fs-5" style="color:#1e7e34;">
                        Q @Model.FacturaTotal.ToString("0.00")
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Pagos -->
    @if (Model.Pagos != null && Model.Pagos.Any())
    {
        <h3 class="h6 fw-semibold mb-2">Pagos registrados</h3>
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (var pago in Model.Pagos)
            {
                <div class="border rounded-3 px-3 py-2">
                    <span class="badge rounded-pill me-2"
                          style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                        @pago.MetodoPago.MetodoPagoNombre
                    </span>
                    <span class="fw-semibold">Q @pago.PagoMonto.ToString("0.00")</span>
                    @if (!string.IsNullOrWhiteSpace(pago.PagoReferencia))
                    {
                        <span class="text-muted small ms-2">Ref: @pago.PagoReferencia</span>
                    }
                    <span class="text-muted small ms-2">
                        @pago.PagoFecha.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>
            }
        </div>
    }

    <hr class="my-3" />

    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Volver al corte
        </a>

        <a asp-action="Facturas" class="btn btn-outline-success">
            Ver facturas
        </a>

        <a asp-action="FacturaImprimir"
           asp-route-id="@Model.FacturaId"
           target="_blank"
           class="btn btn-success">
            Guardar PDF / Imprimir
        </a>
    </div>
</div>