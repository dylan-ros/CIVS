@model CIVS.Models.Factura

@{
    Layout = null;

    var pagoActivo = Model.Pagos?.FirstOrDefault(p => p.PagoEstado);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Factura @(Model.FacturaNumero ?? $"#{Model.FacturaId}")</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            color: #111827;
            background: #f3f4f6;
            margin: 0;
            padding: 30px;
        }

        .factura {
            width: 760px;
            margin: 0 auto;
            background: #ffffff;
            border: 1px solid #d1d5db;
            border-radius: 14px;
            padding: 32px;
        }

        .top-actions {
            width: 760px;
            margin: 0 auto 16px auto;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .btn {
            border: none;
            border-radius: 8px;
            padding: 10px 14px;
            cursor: pointer;
            font-size: 14px;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: #1e7e34;
            color: white;
        }

        .btn-secondary {
            background: white;
            color: #374151;
            border: 1px solid #d1d5db;
        }

        .header {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            border-bottom: 2px solid #1e7e34;
            padding-bottom: 18px;
            margin-bottom: 24px;
        }

        .brand h1 {
            margin: 0;
            color: #1e7e34;
            font-size: 28px;
        }

        .brand p {
            margin: 4px 0;
            color: #6b7280;
            font-size: 13px;
        }

        .factura-info {
            text-align: right;
        }

            .factura-info h2 {
                margin: 0;
                font-size: 22px;
                color: #111827;
            }

            .factura-info p {
                margin: 5px 0;
                color: #6b7280;
                font-size: 13px;
            }

        .badge {
            display: inline-block;
            border-radius: 999px;
            padding: 5px 10px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-pagada {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .badge-pendiente {
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
        }

        .section {
            margin-bottom: 24px;
        }

        .section-title {
            color: #1e7e34;
            font-size: 15px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .info-box {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 12px;
            background: #f9fafb;
        }

        .label {
            color: #6b7280;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .value {
            font-weight: bold;
            font-size: 14px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            background: #f3f4f6;
            border-bottom: 1px solid #d1d5db;
            padding: 10px;
            text-align: left;
            font-size: 13px;
        }

        tbody td {
            border-bottom: 1px solid #e5e7eb;
            padding: 10px;
            font-size: 13px;
        }

        .text-center {
            text-align: center;
        }

        .text-end {
            text-align: right;
        }

        .total-box {
            margin-left: auto;
            width: 300px;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #d1d5db;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 14px;
            border-bottom: 1px solid #e5e7eb;
        }

        .total-final {
            background: #1e7e34;
            color: white;
            font-size: 18px;
            font-weight: bold;
        }

        .footer {
            margin-top: 34px;
            border-top: 1px solid #e5e7eb;
            padding-top: 14px;
            color: #6b7280;
            font-size: 12px;
            text-align: center;
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .top-actions {
                display: none;
            }

            .factura {
                width: auto;
                margin: 0;
                border: none;
                border-radius: 0;
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <div class="top-actions no-print">
        <a href="javascript:history.back()" class="btn btn-secondary">
            Volver
        </a>

        <button type="button" class="btn btn-primary" onclick="window.print()">
            Guardar PDF / Imprimir
        </button>
    </div>

    <div class="factura">

        <div class="header">
            <div class="brand">
                <h1>CIVS</h1>
                <p>Clínica Integral Vida Sana</p>
                <p>Factura generada desde el módulo de Corte de Caja</p>
            </div>

            <div class="factura-info">
                <h2>Factura @(Model.FacturaNumero ?? $"#{Model.FacturaId}")</h2>
                <p>Fecha: @Model.FacturaFecha.ToString("dd/MM/yyyy HH:mm")</p>

                @switch (Model.FacturaEstado)
                {
                    case CIVS.Models.EstadoFactura.Pagada:
                        <span class="badge badge-pagada">Pagada</span>
                        break;

                    case CIVS.Models.EstadoFactura.Emitida:
                        <span class="badge badge-pendiente">Pendiente</span>
                        break;

                    case CIVS.Models.EstadoFactura.Anulada:
                        <span class="badge">Anulada</span>
                        break;
                }
            </div>
        </div>

        <div class="section">
            <div class="section-title">Datos del paciente</div>

            <div class="info-grid">
                <div class="info-box">
                    <div class="label">Paciente</div>
                    <div class="value">
                        @Model.Paciente.PacienteNombres @Model.Paciente.PacienteApellido
                    </div>
                </div>

                <div class="info-box">
                    <div class="label">DPI</div>
                    <div class="value">
                        @(string.IsNullOrWhiteSpace(Model.Paciente.PacienteDPI) ? "—" : Model.Paciente.PacienteDPI)
                    </div>
                </div>

                <div class="info-box">
                    <div class="label">Teléfono</div>
                    <div class="value">
                        @(string.IsNullOrWhiteSpace(Model.Paciente.PacienteTelefono) ? "—" : Model.Paciente.PacienteTelefono)
                    </div>
                </div>

                <div class="info-box">
                    <div class="label">Método de pago</div>
                    <div class="value">
                        @(pagoActivo?.MetodoPago?.MetodoPagoNombre ?? "Sin pago registrado")
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Cita != null && Model.Cita.Medico != null)
        {
            <div class="section">
                <div class="section-title">Datos de atención</div>

                <div class="info-grid">
                    <div class="info-box">
                        <div class="label">Médico</div>
                        <div class="value">
                            Dr. @Model.Cita.Medico.MedicoNombres @Model.Cita.Medico.MedicoApellidos
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="label">Fecha de cita</div>
                        <div class="value">
                            @Model.Cita.CitaFechaInicio.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="section">
            <div class="section-title">Detalle de factura</div>

            <table>
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Precio unitario</th>
                        <th class="text-end">Descuento</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>@d.DetalleDescripcion</td>
                            <td class="text-center">@d.DetalleCantidad</td>
                            <td class="text-end">Q @d.DetallePrecioUnitario.ToString("0.00")</td>
                            <td class="text-end">
                                @(d.DetalleDescuento > 0 ? $"Q {d.DetalleDescuento:0.00}" : "—")
                            </td>
                            <td class="text-end">
                                Q @d.DetalleTotalLinea.ToString("0.00")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="total-box">
            <div class="total-row">
                <span>Subtotal</span>
                <strong>Q @Model.FacturaSubtotal.ToString("0.00")</strong>
            </div>

            <div class="total-row">
                <span>Descuento</span>
                <strong>Q @Model.FacturaDescuento.ToString("0.00")</strong>
            </div>

            <div class="total-row total-final">
                <span>Total</span>
                <span>Q @Model.FacturaTotal.ToString("0.00")</span>
            </div>
        </div>

        @if (pagoActivo != null)
        {
            <div class="section" style="margin-top:24px;">
                <div class="section-title">Información de pago</div>

                <div class="info-grid">
                    <div class="info-box">
                        <div class="label">Fecha de pago</div>
                        <div class="value">@pagoActivo.PagoFecha.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="info-box">
                        <div class="label">Referencia</div>
                        <div class="value">
                            @(string.IsNullOrWhiteSpace(pagoActivo.PagoReferencia) ? "—" : pagoActivo.PagoReferencia)
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="footer">
            Documento generado por CIVS — Corte de Caja.
            <br />
            Esta factura puede guardarse como PDF desde la opción de impresión del navegador.
        </div>

    </div>

</body>
</html>