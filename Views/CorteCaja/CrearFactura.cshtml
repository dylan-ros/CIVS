@{
    ViewData["Title"] = "Crear factura";
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-3 mx-0">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form asp-action="CrearFactura" asp-controller="CorteCaja" method="post" class="mt-3">
    <div class="bg-white border rounded-4 shadow-sm p-4">

        <!-- Encabezado -->
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill"
                          style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                        Corte de Caja
                    </span>
                    <span class="text-muted small">Facturación</span>
                </div>
                <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                    Crear nueva factura
                </h2>
                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <a asp-controller="CorteCaja"
                       asp-action="FacturasPendientes"
                       class="btn btn-warning btn-sm">
                        Facturas pendientes de cobrar
                    </a>
                </div>
            </div>
        </div>

        <hr class="my-3" />

        <!-- Datos del paciente y pago -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 fw-semibold mb-0">Datos de la factura</h3>
                <span class="text-muted small">Campos obligatorios</span>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Paciente</label>
                    <select name="PacienteId" class="form-select" required>
                        <option value="">-- Seleccionar paciente --</option>
                        @foreach (var item in ViewBag.Pacientes as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Cita asociada
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <select name="CitaId" class="form-select">
                        <option value="">-- Sin cita asociada --</option>
                        @foreach (var item in ViewBag.Citas as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Método de pago</label>
                    <select name="MetodoPagoId" class="form-select" required>
                        <option value="">-- Seleccionar --</option>
                        @foreach (var item in ViewBag.MetodosPago as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">
                        Referencia
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <input name="PagoReferencia" class="form-control"
                           placeholder="No. de cheque, transferencia..." />
                </div>
            </div>
        </div>

        <hr class="my-3" />

        <!-- Líneas de servicios -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h6 fw-semibold mb-0">Servicios / productos</h3>
                <button type="button" class="btn btn-outline-success btn-sm"
                        onclick="agregarLinea()">
                    + Agregar línea
                </button>
            </div>

            <div id="contenedor-lineas"></div>

            <div id="mensaje-vacio" class="alert alert-light border text-center text-muted small">
                Hacé clic en <strong>"+ Agregar línea"</strong> para añadir servicios a la factura.
            </div>
        </div>

        <!-- Resumen de totales -->
        <div class="d-flex justify-content-end mb-4">
            <div class="border rounded-3 p-3 bg-light" style="min-width:260px;">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Subtotal</span>
                    <span class="fw-semibold" id="resumen-subtotal">Q 0.00</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">Total</span>
                    <span class="fw-bold text-success fs-5" id="resumen-total">Q 0.00</span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">Emitir factura</button>
            <a asp-controller="CorteCaja" asp-action="Index"
               class="btn btn-outline-secondary">Cancelar</a>
        </div>

    </div>
</form>

@section Scripts {
    <script>
        let indice = 0;

        function agregarLinea() {
            const contenedor = document.getElementById('contenedor-lineas');
            document.getElementById('mensaje-vacio').style.display = 'none';

            const linea = document.createElement('div');
            linea.className = 'border rounded-3 p-3 mb-2 bg-light position-relative';
            linea.id = `linea-${indice}`;
            linea.innerHTML = `
                <button type="button"
                        class="btn-close position-absolute top-0 end-0 m-2"
                        onclick="eliminarLinea(${indice})"
                        title="Eliminar línea"></button>
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small">Descripción <span class="text-danger">*</span></label>
                        <input name="DetalleDescripcion" class="form-control form-control-sm"
                               placeholder="Ej. Consulta general, Hemograma..."
                               oninput="calcularTotal()" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Cantidad</label>
                        <input name="DetalleCantidad" type="number" min="1" value="1"
                               class="form-control form-control-sm"
                               oninput="calcularTotal()" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Precio unit. (Q)</label>
                        <input name="DetallePrecioUnitario" type="number" min="0" step="0.01" value="0.00"
                               class="form-control form-control-sm"
                               oninput="calcularTotal()" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Descuento (Q)</label>
                        <input name="DetalleDescuento" type="number" min="0" step="0.01" value="0.00"
                               class="form-control form-control-sm"
                               oninput="calcularTotal()" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Total línea</label>
                        <input class="form-control form-control-sm bg-white fw-semibold"
                               id="total-linea-${indice}" readonly value="Q 0.00" />
                    </div>
                </div>`;

            contenedor.appendChild(linea);
            indice++;
            calcularTotal();
        }

        function eliminarLinea(id) {
            const linea = document.getElementById(`linea-${id}`);
            if (linea) linea.remove();
            const contenedor = document.getElementById('contenedor-lineas');
            if (contenedor.children.length === 0)
                document.getElementById('mensaje-vacio').style.display = '';
            calcularTotal();
        }

        function calcularTotal() {
            const cantidades  = document.querySelectorAll('[name="DetalleCantidad"]');
            const precios     = document.querySelectorAll('[name="DetallePrecioUnitario"]');
            const descuentos  = document.querySelectorAll('[name="DetalleDescuento"]');

            let subtotal = 0;

            cantidades.forEach((_, i) => {
                const cant  = parseFloat(cantidades[i]?.value  || 0);
                const prec  = parseFloat(precios[i]?.value     || 0);
                const desc  = parseFloat(descuentos[i]?.value  || 0);
                const total = (cant * prec) - desc;
                subtotal   += total;

                const campo = document.getElementById(`total-linea-${i}`);
                if (campo) campo.value = `Q ${total.toFixed(2)}`;
            });

            document.getElementById('resumen-subtotal').textContent = `Q ${subtotal.toFixed(2)}`;
            document.getElementById('resumen-total').textContent    = `Q ${subtotal.toFixed(2)}`;
        }
    </script>
}