@model List<CIVS.Models.OrdenExamen>

@{
    ViewData["Title"] = "Consulta de laboratorio";
    var q = ViewBag.Q as string;
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="bg-white border rounded-4 shadow-sm p-4">

    <!-- Encabezado -->
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill"
                      style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                    Laboratorio
                </span>
                <span class="text-muted small">Órdenes de Examen</span>
            </div>
            <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                Consulta de órdenes de laboratorio
            </h2>
            <p class="text-muted mb-0">
                Buscá por nombre del paciente, DPI o tipo de examen.
            </p>
        </div>
        <div class="d-flex gap-2">
           <a asp-action="CrearExamen" class="btn btn-outline-success">+ Nuevo examen</a>
            <a asp-action="CrearOrden" class="btn btn-primary">+ Nueva orden</a>
        </div>
    </div>

    <hr class="my-3" />

    <!-- Buscador -->
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-12 col-md-6">
            <label class="form-label">Buscar</label>
            <input name="q" value="@q" class="form-control"
                   placeholder="Ej. Juan García, 1234567890101, Hemograma..." />
        </div>
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-outline-primary w-100">Buscar</button>
        </div>
        <div class="col-12 col-md-auto">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
        </div>
    </form>

    <!-- Resultados -->
    @if (string.IsNullOrWhiteSpace(q))
    {
        <div class="alert alert-light border mb-0">
            Ingresá un término de búsqueda para consultar órdenes de laboratorio.
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-light border mb-0">
            No se encontraron órdenes para: <strong>@q</strong>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Paciente</th>
                        <th>Examen</th>
                        <th>Fecha orden</th>
                        <th>Estado</th>
                        <th>Resultado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">
                                    @o.Consulta.Cita.Paciente.PacienteNombres
                                    @o.Consulta.Cita.Paciente.PacienteApellido
                                </span>
                                <br />
                                <span class="text-muted small">@o.Consulta.Cita.Paciente.PacienteDPI</span>
                            </td>
                            <td>@o.Examen.ExamenNombre</td>
                            <td>@o.OrdenFecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @switch (o.OrdenEstado)
                                {
                                    case CIVS.Models.EstadoOrdenExamen.Solicitado:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Solicitado</span>
                                        break;
                                    case CIVS.Models.EstadoOrdenExamen.Tomado:
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Tomado</span>
                                        break;
                                    case CIVS.Models.EstadoOrdenExamen.Procesado:
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Procesado</span>
                                        break;
                                    case CIVS.Models.EstadoOrdenExamen.Entregado:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Entregado</span>
                                        break;
                                    case CIVS.Models.EstadoOrdenExamen.Cancelado:
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Cancelado</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (o.ResultadoFecha.HasValue)
                                {
                                    <span class="text-muted small">@o.ResultadoFecha.Value.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Pendiente</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Detalle" asp-route-id="@o.OrdenExamenId"
                                   class="btn btn-sm btn-outline-primary">
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mb-0 mt-2">
            @Model.Count orden(es) encontrada(s) para «@q».
        </p>
    }

</div>

@section Scripts {
    <script>
        setTimeout(function () {
            const alertEl = document.querySelector('.alert.alert-success, .alert.alert-danger');
            if (alertEl) {
                bootstrap.Alert.getOrCreateInstance(alertEl).close();
            }
        }, 3000);
    </script>
}