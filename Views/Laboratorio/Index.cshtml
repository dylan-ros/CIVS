@model List<CIVS.Models.OrdenExamen>

@{
    ViewData["Title"] = "Consulta de órdenes de examen";
    var q = ViewBag.Q as string;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="bg-white border rounded-4 shadow-sm p-4">

    <!-- Encabezado -->
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill"
                      style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                    Laboratorio
                </span>
                <span class="text-muted small">Órdenes de examen</span>
            </div>

            <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                Consulta de órdenes
            </h2>

            <p class="text-muted mb-0">
                Buscá órdenes por paciente, DPI o tipo de examen.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Laboratorio" asp-action="CrearOrden" class="btn btn-primary">
                + Nueva orden
            </a>
        </div>
    </div>

    <hr class="my-3" />

    <!-- Buscador -->
    <form method="get" asp-controller="Laboratorio" asp-action="Index" class="row g-2 align-items-end mb-3">
        <div class="col-12 col-md-6">
            <label class="form-label">Buscar</label>
            <input name="q"
                   value="@q"
                   class="form-control"
                   placeholder="Ej. Diana, Hemograma, DPI..." />
        </div>

        <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-outline-primary w-100">
                Buscar
            </button>
        </div>

        <div class="col-12 col-md-auto">
            <a asp-controller="Laboratorio" asp-action="Index" class="btn btn-outline-secondary w-100">
                Limpiar
            </a>
        </div>
    </form>

    <!-- Resultados -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-light border mb-0">
            No se encontraron órdenes de examen.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>No. orden</th>
                        <th>Paciente</th>
                        <th>DPI</th>
                        <th>Examen</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var orden in Model)
                    {
                        var paciente = orden.Consulta?.Cita?.Paciente;
                        var examen = orden.Examen;

                        <tr>
                            <td class="fw-semibold">
                                #@orden.OrdenExamenId
                            </td>

                            <td>
                                @if (paciente != null)
                                {
                                    <span>@paciente.PacienteNombres @paciente.PacienteApellido</span>
                                }
                                else
                                {
                                    <span class="text-muted">Sin paciente</span>
                                }
                            </td>

                            <td>
                                @if (paciente != null)
                                {
                                    <span>@paciente.PacienteDPI</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td>
                                @if (examen != null)
                                {
                                    <span>@examen.ExamenNombre</span>
                                }
                                else
                                {
                                    <span class="text-muted">Sin examen</span>
                                }
                            </td>

                            <td>
                                @orden.OrdenFecha.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @switch (orden.OrdenEstado)
                                {
                                    case CIVS.Models.EstadoOrdenExamen.Solicitado:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            Solicitado
                                        </span>
                                        break;

                                    case CIVS.Models.EstadoOrdenExamen.Tomado:
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                                            Tomado
                                        </span>
                                        break;

                                    case CIVS.Models.EstadoOrdenExamen.Procesado:
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            Procesado
                                        </span>
                                        break;

                                    case CIVS.Models.EstadoOrdenExamen.Entregado:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            Entregado
                                        </span>
                                        break;

                                    case CIVS.Models.EstadoOrdenExamen.Cancelado:
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            Cancelado
                                        </span>
                                        break;

                                    default:
                                        <span class="badge bg-light text-muted border">
                                            @orden.OrdenEstado
                                        </span>
                                        break;
                                }
                            </td>

                            <td class="text-end">
                                <a asp-controller="Laboratorio"
                                   asp-action="Detalle"
                                   asp-route-id="@orden.OrdenExamenId"
                                   class="btn btn-sm btn-outline-success">
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted small mb-0 mt-2">
            @Model.Count orden(es) encontrada(s).
        </p>
    }
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            document.querySelectorAll('.alert.alert-success, .alert.alert-danger')
                .forEach(function (alertEl) {
                    bootstrap.Alert.getOrCreateInstance(alertEl).close();
                });
        }, 3000);
    </script>
}