@model CIVS.Models.OrdenExamen

@{
    ViewData["Title"] = "Detalle de orden";
}

<div class="bg-white border rounded-4 shadow-sm p-4 mt-3">

    <!-- Encabezado -->
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill"
                      style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                    Laboratorio
                </span>
                <span class="text-muted small">Detalle de Orden #@Model.OrdenExamenId</span>
            </div>
            <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34;">
                @Model.Examen.ExamenNombre
            </h2>
            <p class="text-muted mb-0">
                @Model.Consulta.Cita.Paciente.PacienteNombres
                @Model.Consulta.Cita.Paciente.PacienteApellido
                &mdash; DPI: @Model.Consulta.Cita.Paciente.PacienteDPI
            </p>
        </div>

        <!-- Badge de estado -->
        <div>
            @switch (Model.OrdenEstado)
            {
                case CIVS.Models.EstadoOrdenExamen.Solicitado:
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-6 px-3 py-2">Solicitado</span>
                    break;
                case CIVS.Models.EstadoOrdenExamen.Tomado:
                    <span class="badge bg-info-subtle text-info border border-info-subtle fs-6 px-3 py-2">Tomado</span>
                    break;
                case CIVS.Models.EstadoOrdenExamen.Procesado:
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-2">Procesado</span>
                    break;
                case CIVS.Models.EstadoOrdenExamen.Entregado:
                    <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-2">Entregado</span>
                    break;
                case CIVS.Models.EstadoOrdenExamen.Cancelado:
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fs-6 px-3 py-2">Cancelado</span>
                    break;
            }
        </div>
    </div>

    <hr class="my-3" />

    <!-- Información de la orden -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <p class="text-muted small mb-1">Médico</p>
            <p class="fw-semibold mb-0">
                Dr. @Model.Consulta.Cita.Medico.MedicoNombres
                @Model.Consulta.Cita.Medico.MedicoApellidos
            </p>
        </div>
        <div class="col-md-3">
            <p class="text-muted small mb-1">Fecha de orden</p>
            <p class="fw-semibold mb-0">@Model.OrdenFecha.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="col-md-3">
            <p class="text-muted small mb-1">Fecha de resultado</p>
            <p class="fw-semibold mb-0">
                @(Model.ResultadoFecha.HasValue
                                ? Model.ResultadoFecha.Value.ToString("dd/MM/yyyy")
                                : "Pendiente")
            </p>
        </div>
        <div class="col-md-3">
            <p class="text-muted small mb-1">Precio del examen</p>
            <p class="fw-semibold mb-0">
                @(Model.Examen.ExamenPrecio.HasValue
                                ? "Q " + Model.Examen.ExamenPrecio.Value.ToString("0.00")
                                : "No definido")
            </p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ResultadoTexto))
    {
        <div class="alert alert-light border mb-4">
            <p class="text-muted small mb-1 fw-semibold">Observaciones</p>
            <p class="mb-0">@Model.ResultadoTexto</p>
        </div>
    }

    <!-- Cambiar estado -->
    @if (Model.OrdenEstado != CIVS.Models.EstadoOrdenExamen.Entregado &&
        Model.OrdenEstado != CIVS.Models.EstadoOrdenExamen.Cancelado)
    {
        <div class="mb-4">
            <h3 class="h6 fw-semibold mb-3">Actualizar estado de la orden</h3>
            <div class="d-flex flex-wrap gap-2">

                @if (Model.OrdenEstado == CIVS.Models.EstadoOrdenExamen.Solicitado)
                {
                    <form asp-action="CambiarEstado" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrdenExamenId" />
                        <input type="hidden" name="estado" value="2" />
                        <button type="submit" class="btn btn-info btn-sm">Marcar como Tomado</button>
                    </form>
                }

                @if (Model.OrdenEstado == CIVS.Models.EstadoOrdenExamen.Tomado)
                {
                    <form asp-action="CambiarEstado" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrdenExamenId" />
                        <input type="hidden" name="estado" value="3" />
                        <button type="submit" class="btn btn-primary btn-sm">Marcar como Procesado</button>
                    </form>
                }

                @if (Model.OrdenEstado == CIVS.Models.EstadoOrdenExamen.Procesado)
                {
                    <form asp-action="CambiarEstado" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.OrdenExamenId" />
                        <input type="hidden" name="estado" value="4" />
                        <button type="submit" class="btn btn-success btn-sm">Marcar como Entregado</button>
                    </form>
                }

                <form asp-action="CambiarEstado" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OrdenExamenId" />
                    <input type="hidden" name="estado" value="5" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm"
                            onclick="return confirm('¿Estás seguro de cancelar esta orden?')">
                        Cancelar orden
                    </button>
                </form>
            </div>
        </div>
    }

    <hr class="my-3" />

    <!-- Botón volver -->
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
    <script>
        setTimeout(function () {
            const alertEl = document.querySelector('.alert.alert-success');
            if (alertEl) bootstrap.Alert.getOrCreateInstance(alertEl).close();
        }, 3000);
    </script>
}