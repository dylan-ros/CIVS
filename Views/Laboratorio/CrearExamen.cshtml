@model CIVS.Models.Examen

@{
    ViewData["Title"] = "Crear examen";
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<form asp-action="CrearExamen" asp-controller="Laboratorio" method="post" class="mt-3">
    <div class="bg-white border rounded-4 shadow-sm p-4">

        <!-- Encabezado -->
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill"
                          style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                        Laboratorio
                    </span>
                    <span class="text-muted small">Catálogo de Exámenes</span>
                </div>
                <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                    Registrar nuevo examen
                </h2>
            </div>
        </div>

        <hr class="my-3" />

        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 fw-semibold mb-0">Datos del examen</h3>
                <span class="text-muted small">Campos obligatorios</span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ExamenNombre" class="form-label">Nombre del examen</label>
                    <input asp-for="ExamenNombre" class="form-control"
                           placeholder="Ej. Hemograma completo, Glucosa en ayunas" />
                    <span asp-validation-for="ExamenNombre" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="ExamenPrecio" class="form-label">
                        Precio
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">Q</span>
                        <input asp-for="ExamenPrecio" type="number" step="0.01" min="0"
                               class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="ExamenPrecio" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="ExamenDescripcion" class="form-label">
                        Descripción
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <textarea asp-for="ExamenDescripcion" class="form-control" rows="3"
                              placeholder="Descripción del examen, preparación requerida, etc."></textarea>
                    <span asp-validation-for="ExamenDescripcion" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">Guardar examen</button>
            <a asp-controller="Laboratorio" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        setTimeout(function () {
            const alertEl = document.querySelector('.alert.alert-success');
            if (alertEl) bootstrap.Alert.getOrCreateInstance(alertEl).close();
        }, 3000);
    </script>
}