@model CIVS.Models.OrdenExamen

@{
    ViewData["Title"] = "Crear orden de examen";
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mx-3 mt-3">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form asp-action="CrearOrden" asp-controller="Laboratorio" method="post" class="mt-3" id="formCrearOrden">
    @Html.AntiForgeryToken()

    <input asp-for="ConsultaId" type="hidden" id="ConsultaId" />
    <input asp-for="ExamenId" type="hidden" id="ExamenId" />

    <div class="bg-white border rounded-4 shadow-sm p-4">

        <!-- Encabezado -->
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill"
                          style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                        Laboratorio
                    </span>
                    <span class="text-muted small">Órdenes de Examen</span>
                </div>

                <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                    Crear nueva orden de examen
                </h2>
            </div>
        </div>

        <hr class="my-3" />

        <!-- Datos de la orden -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 fw-semibold mb-0">Datos de la orden</h3>
                <span class="text-muted small">Campos obligatorios</span>
            </div>

            <div class="row g-3">

                <!-- Buscador de consulta -->
                <div class="col-md-6 position-relative">
                    <label class="form-label">Consulta (Paciente)</label>

                    <input id="buscarConsulta"
                           type="text"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Buscar por paciente, DPI o fecha..." />

                    <div id="resultadosConsulta" class="autocomplete-box"></div>

                    <span asp-validation-for="ConsultaId" class="text-danger small"></span>
                    <div class="form-text">
                        Escribí el nombre del paciente, DPI o fecha y seleccioná una coincidencia.
                    </div>
                </div>

                <!-- Buscador de examen -->
                <div class="col-md-6 position-relative">
                    <label class="form-label">Tipo de examen</label>

                    <input id="buscarExamen"
                           type="text"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Buscar examen, ejemplo: Hemograma..." />

                    <div id="resultadosExamen" class="autocomplete-box"></div>

                    <span asp-validation-for="ExamenId" class="text-danger small"></span>
                </div>

                <!-- Observaciones -->
                <div class="col-12">
                    <label asp-for="ResultadoTexto" class="form-label">
                        Observaciones iniciales
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>

                    <textarea asp-for="ResultadoTexto"
                              class="form-control"
                              rows="3"
                              placeholder="Indicaciones especiales, ayuno requerido, etc."></textarea>

                    <span asp-validation-for="ResultadoTexto" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Estado inicial -->
        <div class="alert alert-light border d-flex align-items-center gap-2 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#1e7e34" viewBox="0 0 16 16">
                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
            </svg>
            <span class="small">
                La orden se creará con estado <strong>Solicitado</strong>. Podrás cambiar el estado desde el detalle de la orden.
            </span>
        </div>

        <hr class="my-4" />

        <!-- Botones -->
        <div class="d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">
                Crear orden
            </button>

            <a asp-controller="Laboratorio" asp-action="Index" class="btn btn-outline-secondary">
                Cancelar
            </a>
        </div>
    </div>
</form>

<style>
    .autocomplete-box {
        display: none;
        position: absolute;
        top: 100%;
        left: 12px;
        right: 12px;
        z-index: 1050;
        max-height: 260px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #ced4da;
        border-radius: .75rem;
        box-shadow: 0 10px 24px rgba(0,0,0,.10);
        margin-top: 4px;
    }

    .autocomplete-item {
        padding: .65rem .85rem;
        cursor: pointer;
        border-bottom: 1px solid #f1f3f5;
        font-size: .9rem;
    }

        .autocomplete-item:hover {
            background: #e9f7ef;
            color: #1e7e34;
        }

    .autocomplete-title {
        font-weight: 600;
    }

    .autocomplete-empty {
        padding: .75rem .85rem;
        color: #6c757d;
        font-size: .85rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const consultas = @Html.Raw(ViewBag.ConsultasJson ?? "[]");
        const examenes = @Html.Raw(ViewBag.ExamenesJson ?? "[]");

        function normalizar(texto) {
            return (texto || '')
                .toString()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();
        }

        function escaparHtml(texto) {
            return (texto || '')
                .toString()
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function filtrar(data, texto) {
            const busqueda = normalizar(texto);

            if (!busqueda) {
                return [];
            }

            const palabras = busqueda.split(' ').filter(Boolean);

            return data
                .filter(item => {
                    const textoItem = normalizar(item.texto);
                    return palabras.every(palabra => textoItem.includes(palabra));
                })
                .slice(0, 8);
        }

        function configurarBuscador(config) {
            const input = document.getElementById(config.inputId);
            const hidden = document.getElementById(config.hiddenId);
            const resultados = document.getElementById(config.resultadosId);

            if (!input || !hidden || !resultados) {
                return;
            }

            input.addEventListener('input', function () {
                hidden.value = '';
                resultados.innerHTML = '';

                const texto = input.value.trim();

                if (!texto) {
                    resultados.style.display = 'none';
                    return;
                }

                const encontrados = filtrar(config.data, texto);

                if (encontrados.length === 0) {
                    resultados.innerHTML = `<div class="autocomplete-empty">${config.mensajeVacio}</div>`;
                    resultados.style.display = 'block';
                    return;
                }

                encontrados.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'autocomplete-item';
                    div.innerHTML = `<div class="autocomplete-title">${escaparHtml(item.texto)}</div>`;

                    div.addEventListener('mousedown', function (e) {
                        e.preventDefault();

                        input.value = item.texto;
                        hidden.value = item[config.idField];
                        resultados.style.display = 'none';
                    });

                    resultados.appendChild(div);
                });

                resultados.style.display = 'block';
            });

            input.addEventListener('blur', function () {
                setTimeout(function () {
                    resultados.style.display = 'none';
                }, 160);
            });
        }

        configurarBuscador({
            inputId: 'buscarConsulta',
            hiddenId: 'ConsultaId',
            resultadosId: 'resultadosConsulta',
            data: consultas,
            idField: 'consultaId',
            mensajeVacio: 'No se encontraron consultas con ese texto.'
        });

        configurarBuscador({
            inputId: 'buscarExamen',
            hiddenId: 'ExamenId',
            resultadosId: 'resultadosExamen',
            data: examenes,
            idField: 'examenId',
            mensajeVacio: 'No se encontraron exámenes con ese texto.'
        });

        document.getElementById('formCrearOrden').addEventListener('submit', function (e) {
            const consultaId = document.getElementById('ConsultaId').value;
            const examenId = document.getElementById('ExamenId').value;

            if (!consultaId) {
                e.preventDefault();
                alert('Debés buscar y seleccionar una consulta válida.');
                document.getElementById('buscarConsulta').focus();
                return;
            }

            if (!examenId) {
                e.preventDefault();
                alert('Debés buscar y seleccionar un examen válido.');
                document.getElementById('buscarExamen').focus();
                return;
            }
        });

        setTimeout(function () {
            document.querySelectorAll('.alert.alert-success, .alert.alert-danger')
                .forEach(function (alertEl) {
                    bootstrap.Alert.getOrCreateInstance(alertEl).close();
                });
        }, 3000);
    </script>
}