@{
    ViewData["Title"] = "Crear receta médica";
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mx-3 mt-3">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form asp-action="CrearReceta" asp-controller="Laboratorio" method="post" class="mt-3">
    <div class="bg-white border rounded-4 shadow-sm p-4">

        <!-- Encabezado -->
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill"
                          style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                        Laboratorio
                    </span>
                    <span class="text-muted small">Recetas Médicas</span>
                </div>
                <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                    Crear receta médica
                </h2>
            </div>
        </div>

        <hr class="my-3" />

        <!-- Datos generales -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 fw-semibold mb-0">Datos generales</h3>
                <span class="text-muted small">Campos obligatorios</span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Consulta (Paciente)</label>
                    <select name="ConsultaId" class="form-select" required>
                        <option value="">-- Seleccionar consulta --</option>
                        @foreach (var item in ViewBag.Consultas as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Observaciones generales
                        <span class="text-muted fw-normal">(opcional)</span>
                    </label>
                    <input name="RecetaObservaciones" class="form-control"
                           placeholder="Ej. Tomar con abundante agua, evitar alcohol..." />
                </div>
            </div>
        </div>

        <hr class="my-3" />

        <!-- Líneas de medicamentos -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h6 fw-semibold mb-0">Medicamentos recetados</h3>
                <button type="button" class="btn btn-outline-success btn-sm"
                        onclick="agregarLinea()">
                    + Agregar medicamento
                </button>
            </div>

            <div id="contenedor-lineas"></div>

            <div id="mensaje-vacio" class="alert alert-light border text-center text-muted small">
                Hacé clic en <strong>"+ Agregar medicamento"</strong> para añadir
                medicamentos a la receta.
            </div>
        </div>

        <hr class="my-4" />

        <div class="d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">Guardar receta</button>
            <a asp-controller="Laboratorio" asp-action="Index"
               class="btn btn-outline-secondary">Cancelar</a>
        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const medicamentos = @Html.Raw(ViewBag.MedicamentosJson);
        let indice = 0;

        function agregarLinea() {
            const contenedor = document.getElementById('contenedor-lineas');
            document.getElementById('mensaje-vacio').style.display = 'none';

            const opciones = medicamentos.map(m =>
                `<option value="${m.medicamentoId}">
                    ${m.medicamentoNombre}
                    ${m.medicamentoPresentacion ? ' — ' + m.medicamentoPresentacion : ''}
                    ${m.medicamentoConcentracion ? ' ' + m.medicamentoConcentracion : ''}
                </option>`
            ).join('');

            const linea = document.createElement('div');
            linea.className = 'border rounded-3 p-3 mb-3 bg-light position-relative';
            linea.id = `linea-${indice}`;
            linea.innerHTML = `
                <button type="button"
                        class="btn-close position-absolute top-0 end-0 m-2"
                        onclick="eliminarLinea(${indice})"
                        title="Eliminar"></button>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">
                            Medicamento <span class="text-danger">*</span>
                        </label>
                        <select name="MedicamentoId" class="form-select" required>
                            <option value="">-- Seleccionar --</option>
                            ${opciones}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Dosis</label>
                        <input name="Dosis" class="form-control"
                               placeholder="Ej. 500 mg" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Frecuencia</label>
                        <input name="Frecuencia" class="form-control"
                               placeholder="Ej. Cada 8h" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Duración</label>
                        <input name="Duracion" class="form-control"
                               placeholder="Ej. 7 días" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Indicaciones</label>
                        <input name="Indicaciones" class="form-control"
                               placeholder="Ej. Con comida" />
                    </div>
                </div>`;

            contenedor.appendChild(linea);
            indice++;
        }

        function eliminarLinea(id) {
            const linea = document.getElementById(`linea-${id}`);
            if (linea) linea.remove();
            const contenedor = document.getElementById('contenedor-lineas');
            if (contenedor.children.length === 0)
                document.getElementById('mensaje-vacio').style.display = '';
        }

        setTimeout(function () {
            const alertEl = document.querySelector('.alert.alert-success');
            if (alertEl) bootstrap.Alert.getOrCreateInstance(alertEl).close();
        }, 3000);
    </script>
}